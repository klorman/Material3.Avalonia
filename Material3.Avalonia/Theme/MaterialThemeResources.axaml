<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:symbols="clr-namespace:Material3.Avalonia.Symbols">
    <symbols:SymbolStyle x:Key="Material.SymbolStyle">Outlined</symbols:SymbolStyle>
    <x:Double x:Key="Material.SymbolWeight">400</x:Double>
    <x:Double x:Key="Material.SymbolGrade">0</x:Double>
    <x:Boolean x:Key="Material.SymbolIsFilled">False</x:Boolean>
    <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="avares://Material3.Avalonia/Symbols/MaterialThemeSymbols.axaml" />
        <MergeResourceInclude Source="avares://Material3.Avalonia/Styles/Icons.axaml" />
        <MergeResourceInclude Source="avares://Material3.Avalonia/Strings/InvariantResources.axaml" />
        <MergeResourceInclude Source="avares://Material3.Avalonia/Tokens/Reference/ReferenceTokens.axaml" />
        <MergeResourceInclude Source="avares://Material3.Avalonia/Tokens/System/SystemTokens.axaml" />
        <MergeResourceInclude Source="avares://Material3.Avalonia/Tokens/Component/ComponentTokens.axaml" />
        <MergeResourceInclude Source="avares://Material3.Avalonia/Styles/Components/ComponentThemes.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
