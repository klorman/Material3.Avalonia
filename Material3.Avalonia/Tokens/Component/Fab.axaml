<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tokens="clr-namespace:Material3.Avalonia.Tokens">
    <!-- Small -->
    <x:Double x:Key="MdCompFabContainerHeight">56</x:Double>
    <x:Double x:Key="MdCompFabContainerWidth">56</x:Double>
    <x:Double x:Key="MdCompFabIconSize">24</x:Double>
    <tokens:TokenAlias x:Key="MdCompFabContainerShape" ResourceKey="MdSysShapeCornerLarge" />

    <!-- Medium -->
