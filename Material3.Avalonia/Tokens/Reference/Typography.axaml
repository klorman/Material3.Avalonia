<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="MdRefTypefaceBrand">$Default</FontFamily>
    <FontFamily x:Key="MdRefTypefacePlain">$Default</FontFamily>
    
    <FontFamily x:Key="MdRefTypefaceEmphasizedBrand">$Default</FontFamily>
    <FontFamily x:Key="MdRefTypefaceEmphasizedPlain">$Default</FontFamily>

    
    <FontWeight x:Key="MdRefTypefaceWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="MdRefTypefaceWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="MdRefTypefaceWeightBold">Bold</FontWeight>
</ResourceDictionary>
