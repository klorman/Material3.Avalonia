<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="MdSysShapeCornerNone">0</CornerRadius>
    <!-- Avalonia fits oversized radii to the border bounds, producing the full corner shape. -->
    <CornerRadius x:Key="MdSysShapeCornerFull">9999</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerExtraSmall">4</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerSmall">8</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerMedium">12</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerLarge">16</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerLargeIncreased">20</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerExtraLarge">28</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerExtraLargeIncreased">32</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerExtraExtraLarge">48</CornerRadius>

    <CornerRadius x:Key="MdSysShapeCornerExtraLargeTop">28 28 0 0</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerLargeTop">16 16 0 0</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerLargeStart">16 0 0 16</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerLargeEnd">0 16 16 0</CornerRadius>
    <CornerRadius x:Key="MdSysShapeCornerExtraSmallTop">4 4 0 0</CornerRadius>

    <x:Double x:Key="MdSysShapeCornerValueNone">0</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueExtraSmall">4</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueSmall">8</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueMedium">12</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueLarge">16</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueLargeIncreased">20</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueExtraLarge">28</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueExtraLargeIncreased">32</x:Double>
    <x:Double x:Key="MdSysShapeCornerValueExtraExtraLarge">48</x:Double>
</ResourceDictionary>
