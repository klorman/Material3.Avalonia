        <Style Selector="^.md">
            <Setter Property="Size" Value="Medium" />
        </Style>
        <Style Selector="^.lg">
            <Setter Property="Size" Value="Large" />
        </Style>
        <Style Selector="^.primary-container">
            <Setter Property="Variant" Value="PrimaryContainer" />
        </Style>
        <Style Selector="^.secondary-container">
            <Setter Property="Variant" Value="SecondaryContainer" />
        </Style>
        <Style Selector="^.tertiary-container">
            <Setter Property="Variant" Value="TertiaryContainer" />
        </Style>
        <Style Selector="^.primary">
            <Setter Property="Variant" Value="Primary" />
        </Style>
        <Style Selector="^.secondary">
            <Setter Property="Variant" Value="Secondary" />
        </Style>
        <Style Selector="^.tertiary">
            <Setter Property="Variant" Value="Tertiary" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
