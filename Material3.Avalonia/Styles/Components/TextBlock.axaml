            <Setter Property="LetterSpacing" Value="{markup:Token MdSysTypeScaleLabelLargeTracking}" />
        </Style>
        
        <Style Selector="^[(helpers|Typography.TextStyle)=EmphasizedLabelMedium]">
            <Setter Property="LineHeight" Value="{markup:Token MdSysTypeScaleLabelMediumLineHeight}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdSysTypeScaleLabelMediumTracking}" />
        </Style>
        
        <Style Selector="^[(helpers|Typography.TextStyle)=EmphasizedLabelSmall]">
            <Setter Property="LineHeight" Value="{markup:Token MdSysTypeScaleLabelSmallLineHeight}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdSysTypeScaleLabelSmallTracking}" />
        </Style>

        

        
        
        <Style Selector="^.display-large">
            <Setter Property="helpers:Typography.TextStyle" Value="DisplayLarge" />
        </Style>
        
        <Style Selector="^.display-medium">
            <Setter Property="helpers:Typography.TextStyle" Value="DisplayMedium" />
        </Style>
        
        <Style Selector="^.display-small">
            <Setter Property="helpers:Typography.TextStyle" Value="DisplaySmall" />
        </Style>
        
        <Style Selector="^.headline-large">
            <Setter Property="helpers:Typography.TextStyle" Value="HeadlineLarge" />
        </Style>
        
        <Style Selector="^.headline-medium">
            <Setter Property="helpers:Typography.TextStyle" Value="HeadlineMedium" />
        </Style>
        
        <Style Selector="^.headline-small">
            <Setter Property="helpers:Typography.TextStyle" Value="HeadlineSmall" />
        </Style>
        
        <Style Selector="^.title-large">
            <Setter Property="helpers:Typography.TextStyle" Value="TitleLarge" />
        </Style>
        
        <Style Selector="^.title-medium">
            <Setter Property="helpers:Typography.TextStyle" Value="TitleMedium" />
        </Style>
        
        <Style Selector="^.title-small">
            <Setter Property="helpers:Typography.TextStyle" Value="TitleSmall" />
        </Style>
        
        <Style Selector="^.body-large">
            <Setter Property="helpers:Typography.TextStyle" Value="BodyLarge" />
        </Style>
        
        <Style Selector="^.body-medium">
            <Setter Property="helpers:Typography.TextStyle" Value="BodyMedium" />
        </Style>
        
        <Style Selector="^.body-small">
            <Setter Property="helpers:Typography.TextStyle" Value="BodySmall" />
        </Style>
        
        <Style Selector="^.label-large">
            <Setter Property="helpers:Typography.TextStyle" Value="LabelLarge" />
        </Style>
        
        <Style Selector="^.label-medium">
            <Setter Property="helpers:Typography.TextStyle" Value="LabelMedium" />
        </Style>
        
        <Style Selector="^.label-small">
            <Setter Property="helpers:Typography.TextStyle" Value="LabelSmall" />
        </Style>
        
        <Style Selector="^.display-large-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedDisplayLarge" />
        </Style>
        
        <Style Selector="^.display-medium-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedDisplayMedium" />
        </Style>
        
        <Style Selector="^.display-small-emphasized">
