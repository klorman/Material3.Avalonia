        </Style>
        
        <Style Selector="^.headline-small-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedHeadlineSmall" />
        </Style>
        
        <Style Selector="^.title-large-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedTitleLarge" />
        </Style>
        
        <Style Selector="^.title-medium-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedTitleMedium" />
        </Style>
        
        <Style Selector="^.title-small-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedTitleSmall" />
        </Style>
        
        <Style Selector="^.body-large-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedBodyLarge" />
        </Style>
        
        <Style Selector="^.body-medium-emphasized">
