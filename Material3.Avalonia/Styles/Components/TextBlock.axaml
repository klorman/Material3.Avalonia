        </Style>
        
        <Style Selector="^.body-small-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedBodySmall" />
        </Style>
        
        <Style Selector="^.label-large-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedLabelLarge" />
        </Style>
        
        <Style Selector="^.label-medium-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedLabelMedium" />
        </Style>
        
        <Style Selector="^.label-small-emphasized">
            <Setter Property="helpers:Typography.TextStyle" Value="EmphasizedLabelSmall" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
