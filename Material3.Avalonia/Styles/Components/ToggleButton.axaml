                </Style>
                <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraLarge]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonXlSelectedSquareContainerShape}" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraSmall]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXsPressedContainerShape}" />
            </Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Small]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonSmPressedContainerShape}" />
            </Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Medium]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonMdPressedContainerShape}" />
            </Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Large]">
