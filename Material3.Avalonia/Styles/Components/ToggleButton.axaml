            </Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraLarge]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXlPressedContainerShape}" />
            </Style>
        </Style>

        <!-- Classes -->
        <Style Selector="^.xs">
            <Setter Property="controls:ToggleButtonAssist.Size" Value="ExtraSmall" />
        </Style>
        <Style Selector="^.sm">
            <Setter Property="controls:ToggleButtonAssist.Size" Value="Small" />
        </Style>
        <Style Selector="^.md">
            <Setter Property="controls:ToggleButtonAssist.Size" Value="Medium" />
        </Style>
        <Style Selector="^.lg">
            <Setter Property="controls:ToggleButtonAssist.Size" Value="Large" />
        </Style>
        <Style Selector="^.xl">
            <Setter Property="controls:ToggleButtonAssist.Size" Value="ExtraLarge" />
        </Style>
        <Style Selector="^.round">
            <Setter Property="controls:ToggleButtonAssist.Shape" Value="Round" />
        </Style>
        <Style Selector="^.square">
            <Setter Property="controls:ToggleButtonAssist.Shape" Value="Square" />
        </Style>

        <Style Selector="^.elevated">
            <Setter Property="controls:ToggleButtonAssist.Variant" Value="Elevated" />
        </Style>
        <Style Selector="^.filled">
            <Setter Property="controls:ToggleButtonAssist.Variant" Value="Filled" />
        </Style>
        <Style Selector="^.tonal">
            <Setter Property="controls:ToggleButtonAssist.Variant" Value="Tonal" />
        </Style>
        <Style Selector="^.outlined">
            <Setter Property="controls:ToggleButtonAssist.Variant" Value="Outlined" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
