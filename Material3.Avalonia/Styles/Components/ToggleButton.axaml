                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedIconToggleSelectedBrush}" />
                    <Setter Property="IsFilled" Value="True" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:not(:checked):focus-visible:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleUnselectedFocusedLabelBrush}" />
