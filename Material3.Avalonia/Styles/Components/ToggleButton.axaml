                    <Setter Property="IsFilled" Value="True" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedStateLayerBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedStateLayerOpacity}" />
                </Style>
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^:not(:checked):focus-visible:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedFocusedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedFocusedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedFocusedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedFocusedStateLayerOpacity}" />
                </Style>
                <Setter Property="BorderBrush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedFocusedOutlineBrush}" />
            </Style>
            <Style Selector="^:not(:checked).m3-hovered:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedHoveredLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedHoveredIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedHoveredStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedHoveredStateLayerOpacity}" />
                </Style>
                <Setter Property="BorderBrush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedHoveredOutlineBrush}" />
            </Style>
            <Style Selector="^:not(:checked):pressed:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedPressedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedPressedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedPressedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedPressedStateLayerOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedPressedStateLayerOpacity}" />
                </Style>
                <Setter Property="BorderBrush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedPressedOutlineBrush}" />
            </Style>
            <Style Selector="^:checked:focus-visible:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleSelectedFocusedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleSelectedFocusedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleSelectedFocusedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonOutlinedToggleSelectedFocusedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked.m3-hovered:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleSelectedHoveredLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleSelectedHoveredIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleSelectedHoveredStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonOutlinedToggleSelectedHoveredStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked:pressed:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedStateLayerOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonOutlinedToggleSelectedPressedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{markup:Token MdCompButtonDisabledContainerBrush}" />
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonDisabledLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonDisabledIconBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonDisabledIconOpacity}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Outline">
                    <Setter Property="BoxShadow" Value="{markup:Token MdSysShadowLevel0}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Background">
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonDisabledContainerOpacity}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonDisabledLabelOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{x:Null}" />
                </Style>
                <Setter Property="BorderBrush" Value="{markup:Token MdCompButtonOutlinedToggleUnselectedDisabledOutlineBrush}" />
                <Style Selector="^:checked">
                    <Setter Property="Background" Value="{markup:Token MdCompButtonOutlinedToggleSelectedDisabledContainerBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:checked:not(:pressed)">
            <Style Selector="^[(controls|ButtonAssist.Shape)=Round]">
                <Style Selector="^[(controls|ButtonAssist.Size)=ExtraSmall]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXsSelectedRoundContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=Small]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonSmSelectedRoundContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=Medium]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonMdSelectedRoundContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=Large]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonLgSelectedRoundContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=ExtraLarge]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXlSelectedRoundContainerShape}" />
                </Style>
            </Style>
            <Style Selector="^[(controls|ButtonAssist.Shape)=Square]">
                <Style Selector="^[(controls|ButtonAssist.Size)=ExtraSmall]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonXsSelectedSquareContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=Small]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonSmSelectedSquareContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=Medium]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonMdSelectedSquareContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=Large]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonLgSelectedSquareContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ButtonAssist.Size)=ExtraLarge]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonXlSelectedSquareContainerShape}" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^:pressed:not(:disabled)">
            <Style Selector="^[(controls|ButtonAssist.Size)=ExtraSmall]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXsPressedContainerShape}" />
            </Style>
            <Style Selector="^[(controls|ButtonAssist.Size)=Small]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonSmPressedContainerShape}" />
            </Style>
            <Style Selector="^[(controls|ButtonAssist.Size)=Medium]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonMdPressedContainerShape}" />
            </Style>
            <Style Selector="^[(controls|ButtonAssist.Size)=Large]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonLgPressedContainerShape}" />
            </Style>
            <Style Selector="^[(controls|ButtonAssist.Size)=ExtraLarge]">
                <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXlPressedContainerShape}" />
            </Style>
        </Style>

        <Style Selector="^.elevated">
            <Setter Property="controls:ButtonAssist.Variant" Value="Elevated" />
        </Style>
        <Style Selector="^.filled">
            <Setter Property="controls:ButtonAssist.Variant" Value="Filled" />
        </Style>
        <Style Selector="^.tonal">
            <Setter Property="controls:ButtonAssist.Variant" Value="Tonal" />
        </Style>
        <Style Selector="^.outlined">
            <Setter Property="controls:ButtonAssist.Variant" Value="Outlined" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
