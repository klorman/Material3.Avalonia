<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:internal="clr-namespace:Material3.Avalonia.Attached.Controls.Internal"
                    xmlns:helpers="clr-namespace:Material3.Avalonia.Controls.Helpers"
                    xmlns:markup="clr-namespace:Material3.Avalonia.Markup"
                    xmlns:primitives="clr-namespace:Material3.Avalonia.Controls.Primitives"
                    xmlns:transitions="clr-namespace:Material3.Avalonia.Motion.Transitions"
                    xmlns:controls="clr-namespace:Material3.Avalonia.Attached.Controls"
                    xmlns:attached="clr-namespace:Material3.Avalonia.Attached">

    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource MaterialButtonFamily}">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="PART_Container"
                      ClipToBounds="{TemplateBinding ClipToBounds}"
                      helpers:Typography.TextStyle="{x:Null}">
                    <Border x:Name="PART_Outline"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="PART_Background"
                                Background="{TemplateBinding Background}"
                                Opacity="1"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </Border>

                    <primitives:StateLayer x:Name="PART_StateLayer"
                                           CornerRadius="{TemplateBinding CornerRadius}"
                                           Opacity="0" />

                    <primitives:ButtonContentMotion x:Name="PART_Content"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    IsIconPresented="{TemplateBinding controls:ToggleButtonAssist.Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Opacity="1">
                        <Border x:Name="PART_IconSlot" ClipToBounds="True">
                            <primitives:IconPresenter x:Name="PART_Icon"
                                                      IsHitTestVisible="False"
                                                      IconChangeAnimation="Scale"
                                                      Value="{TemplateBinding controls:ToggleButtonAssist.Icon}">
                                <primitives:IconPresenter.Transitions>
                                    <Transitions>
                                        <transitions:SpringBrushTransition Property="Foreground" Style="Effects" Speed="Fast" />
                                    </Transitions>
                                </primitives:IconPresenter.Transitions>
                            </primitives:IconPresenter>
                        </Border>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding Content}" />
                    </primitives:ButtonContentMotion>

                    <primitives:InkRipple x:Name="PART_Ripple"
                                          CornerRadius="{TemplateBinding CornerRadius}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Size -->
        <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraSmall]">
            <Setter Property="Height" Value="{markup:DensityScalar MdCompButtonXsContainerHeight, MostDense=Dense2}" />
            <Setter Property="BorderThickness" Value="{markup:Token MdCompButtonXsOutlineWidth}" />
            <Setter Property="FontFamily" Value="{markup:Token MdCompButtonXsLabelTextFontFamily}" />
            <Setter Property="FontWeight" Value="{markup:Token MdCompButtonXsLabelTextWeight}" />
            <Setter Property="FontSize" Value="{markup:Token MdCompButtonXsLabelTextSize}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdCompButtonXsLabelTextTracking}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Size" Value="{markup:Token MdCompButtonXsIconSize}" />
            </Style>
            <Setter Property="Padding" Value="{markup:DynamicThickness MdCompButtonXsLeadingSpace MdCompButtonXsVerticalSpace MdCompButtonXsTrailingSpace MdCompButtonXsVerticalSpace}" />
            <Style Selector="^ /template/ primitives|ButtonContentMotion#PART_Content">
                <Setter Property="Gap" Value="{markup:Token MdCompButtonXsBetweenIconLabelSpace}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{markup:Token MdCompButtonXsLabelTextLineHeight}" />
            </Style>
        </Style>

        <Style Selector="^[(controls|ToggleButtonAssist.Size)=Small]">
            <Setter Property="Height" Value="{markup:DensityScalar MdCompButtonSmContainerHeight, MostDense=Dense3}" />
            <Setter Property="BorderThickness" Value="{markup:Token MdCompButtonSmOutlineWidth}" />
            <Setter Property="FontFamily" Value="{markup:Token MdCompButtonSmLabelTextFontFamily}" />
            <Setter Property="FontWeight" Value="{markup:Token MdCompButtonSmLabelTextWeight}" />
            <Setter Property="FontSize" Value="{markup:Token MdCompButtonSmLabelTextSize}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdCompButtonSmLabelTextTracking}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Size" Value="{markup:Token MdCompButtonSmIconSize}" />
            </Style>
            <Setter Property="Padding" Value="{markup:DynamicThickness MdCompButtonSmLeadingSpace MdCompButtonSmVerticalSpace MdCompButtonSmTrailingSpace MdCompButtonSmVerticalSpace}" />
            <Style Selector="^ /template/ primitives|ButtonContentMotion#PART_Content">
                <Setter Property="Gap" Value="{markup:Token MdCompButtonSmBetweenIconLabelSpace}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{markup:Token MdCompButtonSmLabelTextLineHeight}" />
            </Style>
        </Style>

        <Style Selector="^[(controls|ToggleButtonAssist.Size)=Medium]">
            <Setter Property="Height" Value="{markup:DensityScalar MdCompButtonMdContainerHeight, MostDense=Dense3}" />
            <Setter Property="BorderThickness" Value="{markup:Token MdCompButtonMdOutlineWidth}" />
            <Setter Property="FontFamily" Value="{markup:Token MdCompButtonMdLabelTextFontFamily}" />
            <Setter Property="FontWeight" Value="{markup:Token MdCompButtonMdLabelTextWeight}" />
            <Setter Property="FontSize" Value="{markup:Token MdCompButtonMdLabelTextSize}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdCompButtonMdLabelTextTracking}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Size" Value="{markup:Token MdCompButtonMdIconSize}" />
            </Style>
            <Setter Property="Padding" Value="{markup:DynamicThickness MdCompButtonMdLeadingSpace MdCompButtonMdVerticalSpace MdCompButtonMdTrailingSpace MdCompButtonMdVerticalSpace}" />
            <Style Selector="^ /template/ primitives|ButtonContentMotion#PART_Content">
                <Setter Property="Gap" Value="{markup:Token MdCompButtonMdBetweenIconLabelSpace}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{markup:Token MdCompButtonMdLabelTextLineHeight}" />
            </Style>
        </Style>

        <Style Selector="^[(controls|ToggleButtonAssist.Size)=Large]">
            <Setter Property="Height" Value="{markup:DensityScalar MdCompButtonLgContainerHeight, MostDense=Dense3}" />
            <Setter Property="BorderThickness" Value="{markup:Token MdCompButtonLgOutlineWidth}" />
            <Setter Property="FontFamily" Value="{markup:Token MdCompButtonLgLabelTextFontFamily}" />
            <Setter Property="FontWeight" Value="{markup:Token MdCompButtonLgLabelTextWeight}" />
            <Setter Property="FontSize" Value="{markup:Token MdCompButtonLgLabelTextSize}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdCompButtonLgLabelTextTracking}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Size" Value="{markup:Token MdCompButtonLgIconSize}" />
            </Style>
            <Setter Property="Padding" Value="{markup:DynamicThickness MdCompButtonLgLeadingSpace MdCompButtonLgVerticalSpace MdCompButtonLgTrailingSpace MdCompButtonLgVerticalSpace}" />
            <Style Selector="^ /template/ primitives|ButtonContentMotion#PART_Content">
                <Setter Property="Gap" Value="{markup:Token MdCompButtonLgBetweenIconLabelSpace}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{markup:Token MdCompButtonLgLabelTextLineHeight}" />
            </Style>
        </Style>

        <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraLarge]">
            <Setter Property="Height" Value="{markup:DensityScalar MdCompButtonXlContainerHeight, MostDense=Dense3}" />
            <Setter Property="BorderThickness" Value="{markup:Token MdCompButtonXlOutlineWidth}" />
            <Setter Property="FontFamily" Value="{markup:Token MdCompButtonXlLabelTextFontFamily}" />
            <Setter Property="FontWeight" Value="{markup:Token MdCompButtonXlLabelTextWeight}" />
            <Setter Property="FontSize" Value="{markup:Token MdCompButtonXlLabelTextSize}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdCompButtonXlLabelTextTracking}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Size" Value="{markup:Token MdCompButtonXlIconSize}" />
            </Style>
            <Setter Property="Padding" Value="{markup:DynamicThickness MdCompButtonXlLeadingSpace MdCompButtonXlVerticalSpace MdCompButtonXlTrailingSpace MdCompButtonXlVerticalSpace}" />
            <Style Selector="^ /template/ primitives|ButtonContentMotion#PART_Content">
                <Setter Property="Gap" Value="{markup:Token MdCompButtonXlBetweenIconLabelSpace}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{markup:Token MdCompButtonXlLabelTextLineHeight}" />
            </Style>
        </Style>

        <!-- Shape -->
        <Style Selector="^[(controls|ToggleButtonAssist.Shape)=Round]">
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraSmall]"><Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonXsRoundContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Small]"><Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonSmRoundContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Medium]"><Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonMdRoundContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Large]"><Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonLgRoundContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraLarge]"><Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonXlRoundContainerShape}" /></Style>
        </Style>

        <Style Selector="^[(controls|ToggleButtonAssist.Shape)=Square]">
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraSmall]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXsSquareContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Small]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonSmSquareContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Medium]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonMdSquareContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Large]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonLgSquareContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraLarge]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXlSquareContainerShape}" /></Style>
        </Style>

        <Style Selector="^:pressed:not(:disabled), ^.m3-menu-open:not(:disabled)">
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraSmall]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXsPressedContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Small]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonSmPressedContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Medium]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonMdPressedContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=Large]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonLgPressedContainerShape}" /></Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraLarge]"><Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXlPressedContainerShape}" /></Style>
        </Style>

        <Style Selector="^[(controls|ToggleButtonAssist.Variant)=Elevated]">
            <Setter Property="Background" Value="{markup:Token MdCompButtonElevatedContainerToggleUnselectedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedLabelToggleUnselectedBrush}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedIconToggleUnselectedBrush}" />
                <Setter Property="IsFilled" Value="False" />
            </Style>
            <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerBrush}" />
            </Style>
            <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerBrush}" />
                <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerOpacity}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{markup:Token MdCompButtonElevatedContainerElevation}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{markup:Token MdCompButtonElevatedContainerToggleSelectedBrush}" />
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedLabelToggleSelectedBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedIconToggleSelectedBrush}" />
                    <Setter Property="IsFilled" Value="True" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:not(:checked):focus-visible:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleUnselectedFocusedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleUnselectedFocusedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedFocusedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonElevatedToggleUnselectedFocusedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:not(:checked).m3-hovered:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleUnselectedHoveredLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleUnselectedHoveredIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedHoveredStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonElevatedToggleUnselectedHoveredStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:not(:checked):pressed:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked:focus-visible:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleSelectedFocusedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleSelectedFocusedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedFocusedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonElevatedToggleSelectedFocusedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked.m3-hovered:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleSelectedHoveredLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleSelectedHoveredIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedHoveredStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonElevatedToggleSelectedHoveredStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked:pressed:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonElevatedToggleSelectedPressedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{markup:Token MdCompButtonDisabledContainerBrush}" />
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonDisabledLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonDisabledIconBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonDisabledIconOpacity}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Outline">
                    <Setter Property="BoxShadow" Value="{markup:Token MdCompButtonElevatedDisabledContainerElevation}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Background">
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonDisabledContainerOpacity}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonDisabledLabelOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{x:Null}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[(controls|ToggleButtonAssist.Variant)=Filled]">
            <Setter Property="Background" Value="{markup:Token MdCompButtonFilledContainerToggleUnselectedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledLabelToggleUnselectedBrush}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledIconToggleUnselectedBrush}" />
                <Setter Property="IsFilled" Value="False" />
            </Style>
            <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedStateLayerBrush}" />
            </Style>
            <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedStateLayerBrush}" />
                <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedStateLayerOpacity}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{markup:Token MdCompButtonFilledContainerElevation}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{markup:Token MdCompButtonFilledContainerToggleSelectedBrush}" />
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledLabelToggleSelectedBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledIconToggleSelectedBrush}" />
                    <Setter Property="IsFilled" Value="True" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleSelectedPressedStateLayerBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleSelectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonFilledToggleSelectedPressedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:not(:checked):focus-visible:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleUnselectedFocusedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleUnselectedFocusedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleUnselectedFocusedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonFilledToggleUnselectedFocusedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:not(:checked).m3-hovered:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleUnselectedHoveredLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleUnselectedHoveredIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleUnselectedHoveredStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonFilledToggleUnselectedHoveredStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:not(:checked):pressed:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedStateLayerOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedStateLayerBrush}" />
                    <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonFilledToggleUnselectedPressedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked:focus-visible:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleSelectedFocusedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleSelectedFocusedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleSelectedFocusedStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonFilledToggleSelectedFocusedStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked.m3-hovered:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleSelectedHoveredLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleSelectedHoveredIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleSelectedHoveredStateLayerBrush}" />
                    <Setter Property="Opacity" Value="{markup:Token MdCompButtonFilledToggleSelectedHoveredStateLayerOpacity}" />
                </Style>
            </Style>
            <Style Selector="^:checked:pressed:not(:disabled)">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleSelectedPressedLabelBrush}" />
                <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                    <Setter Property="Foreground" Value="{markup:Token MdCompButtonFilledToggleSelectedPressedIconBrush}" />
                </Style>
                <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                    <Setter Property="Brush" Value="{markup:Token MdCompButtonFilledToggleSelectedPressedStateLayerBrush}" />
