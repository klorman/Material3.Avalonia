            </Style>
            <Style Selector="^[(controls|ToggleButtonAssist.Shape)=Square]">
                <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraSmall]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonXsSelectedSquareContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ToggleButtonAssist.Size)=Small]">
                    <Setter Property="CornerRadius" Value="{markup:DynamicCornerRadius MdCompButtonSmSelectedSquareContainerShape}" />
