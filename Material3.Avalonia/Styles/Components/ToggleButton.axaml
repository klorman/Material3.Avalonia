<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:internal="clr-namespace:Material3.Avalonia.Attached.Controls.Internal"
                    xmlns:helpers="clr-namespace:Material3.Avalonia.Controls.Helpers"
                    xmlns:markup="clr-namespace:Material3.Avalonia.Markup"
                    xmlns:primitives="clr-namespace:Material3.Avalonia.Controls.Primitives"
                    xmlns:transitions="clr-namespace:Material3.Avalonia.Motion.Transitions"
                    xmlns:controls="clr-namespace:Material3.Avalonia.Attached.Controls"
                    xmlns:attached="clr-namespace:Material3.Avalonia.Attached">

    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource MaterialButtonFamily}">
        <Style Selector="^[(controls|ButtonAssist.Variant)=Elevated]">
            <Setter Property="Background" Value="{markup:Token MdCompButtonElevatedContainerToggleUnselectedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedLabelToggleUnselectedBrush}" />
            <Style Selector="^ /template/ primitives|IconPresenter#PART_Icon">
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedIconToggleUnselectedBrush}" />
                <Setter Property="IsFilled" Value="False" />
            </Style>
            <Style Selector="^ /template/ primitives|StateLayer#PART_StateLayer">
                <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerBrush}" />
            </Style>
            <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                <Setter Property="Brush" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerBrush}" />
                <Setter Property="BaseOpacity" Value="{markup:Token MdCompButtonElevatedToggleUnselectedPressedStateLayerOpacity}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{markup:Token MdCompButtonElevatedContainerElevation}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{markup:Token MdCompButtonElevatedContainerToggleSelectedBrush}" />
                <Setter Property="Foreground" Value="{markup:Token MdCompButtonElevatedLabelToggleSelectedBrush}" />
