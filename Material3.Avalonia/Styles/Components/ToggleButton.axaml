        <Style Selector="^:checked:not(:pressed)">
            <Style Selector="^[(controls|ToggleButtonAssist.Shape)=Round]">
                <Style Selector="^[(controls|ToggleButtonAssist.Size)=ExtraSmall]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonXsSelectedRoundContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ToggleButtonAssist.Size)=Small]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonSmSelectedRoundContainerShape}" />
                </Style>
                <Style Selector="^[(controls|ToggleButtonAssist.Size)=Medium]">
                    <Setter Property="CornerRadius" Value="{markup:Token MdCompButtonMdSelectedRoundContainerShape}" />
