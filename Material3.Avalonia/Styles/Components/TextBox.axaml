            </Style>
            <Style Selector="^:error:not(:disabled) /template/ ContentPresenter#PART_TrailingContent, ^.m3-text-field-manual-error:not(:disabled) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon, ^.m3-text-field-manual-error:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ TextBlock#PART_SupportingText, ^:error:not(:disabled) /template/ TextBlock#PART_CharacterCounter, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_SupportingText, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorSupportingTextBrush}" />
            </Style>

            <!-- Error + Hover. -->
            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ primitives|NotchedOutline#PART_OutlinedOutline, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="Stroke" Value="{DynamicResource MdCompOutlinedTextFieldErrorHoverOutlineBrush}" />
                <Setter Property="StrokeThickness" Value="{DynamicResource MdCompOutlinedTextFieldHoverOutlineWidth}" />
