            </Style>
            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_SupportingText, ^:error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_CharacterCounter, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_SupportingText, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorHoverSupportingTextBrush}" />
            </Style>

            <!-- Error + Focus. -->
            <Style Selector="^:error:focus:not(:disabled) /template/ primitives|NotchedOutline#PART_OutlinedOutline, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="Stroke" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusOutlineBrush}" />
                <Setter Property="StrokeThickness" Value="{DynamicResource MdCompOutlinedTextFieldFocusOutlineWidth}" />
