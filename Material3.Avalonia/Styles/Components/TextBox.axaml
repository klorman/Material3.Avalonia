            <!-- Error. -->
            <Style Selector="^:error:not(:disabled) /template/ primitives|NotchedOutline#PART_OutlinedOutline, ^.m3-text-field-manual-error:not(:disabled) /template/ primitives|NotchedOutline#PART_OutlinedOutline">
