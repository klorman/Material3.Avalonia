<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:internal="clr-namespace:Material3.Avalonia.Attached.Controls.Internal"
                    xmlns:controls="clr-namespace:Material3.Avalonia.Attached.Controls"
                    xmlns:helpers="clr-namespace:Material3.Avalonia.Controls.Helpers"
                    xmlns:primitives="clr-namespace:Material3.Avalonia.Controls.Primitives"
                    xmlns:converters="clr-namespace:Material3.Avalonia.Converters"
                    xmlns:markup="clr-namespace:Material3.Avalonia.Markup"
                    xmlns:tokens="clr-namespace:Material3.Avalonia.Tokens"
                    xmlns:transitions="clr-namespace:Material3.Avalonia.Motion.Transitions">

    <!-- Material Symbols Outlined, optical size 20 (google/material-design-icons). -->
    <StreamGeometry x:Key="MaterialTextCutIcon">M0 -960h0 M960.0 0.0h0 M744-144 480-407l-87 88q8 16 11.5 32.85 3.5 16.86 3.5 33.71 0 65.44-45 110.94T252-96q-64.35 0-110.18-45.5Q96-187 96-252t45.5-110.5Q187-408 252.44-408q16.85 0 33.71 4Q303-400 319-392l88-87-88-88q-16 8-32.85 11.5-16.86 3.5-33.71 3.5-65.44 0-110.94-45.5T96-708q0-65 45.5-110.5T252-864q65 0 110.5 45.5T408-707.56q0 16.85-3.5 33.71Q401-657 393-641l471 469v28H744ZM595-520l-74-74 223-222h120v28L595-520ZM252.25-624q34.75 0 59.25-24.75t24.5-59.5q0-34.75-24.75-59.25t-59.5-24.5q-34.75 0-59.25 24.75t-24.5 59.5q0 34.75 24.75 59.25t59.5 24.5ZM480-456q9.6 0 16.8-7.2 7.2-7.2 7.2-16.8 0-9.6-7.2-16.8-7.2-7.2-16.8-7.2-9.6 0-16.8 7.2-7.2 7.2-7.2 16.8 0 9.6 7.2 16.8 7.2 7.2 16.8 7.2ZM252.25-168q34.75 0 59.25-24.75t24.5-59.5q0-34.75-24.75-59.25t-59.5-24.5q-34.75 0-59.25 24.75t-24.5 59.5q0 34.75 24.75 59.25t59.5 24.5Z</StreamGeometry>
    <StreamGeometry x:Key="MaterialTextPasteIcon">M0 -960h0 M960.0 0.0h0 M216-144q-29.7 0-50.85-21.15Q144-186.3 144-216v-528q0-29.7 21.15-50.85Q186.3-816 216-816h171q8-31 33.5-51.5T480-888q34 0 59.5 20.5T573-816h171q29.7 0 50.85 21.15Q816-773.7 816-744v528q0 29.7-21.15 50.85Q773.7-144 744-144H216Zm0-72h528v-528h-72v120H288v-120h-72v528Zm263.79-528q15.21 0 25.71-10.29t10.5-25.5q0-15.21-10.29-25.71t-25.5-10.5q-15.21 0-25.71 10.29t-10.5 25.5q0 15.21 10.29 25.71t25.5 10.5Z</StreamGeometry>
    <StreamGeometry x:Key="MaterialTextSelectAllIcon">M0 -960h0 M960.0 0.0h0 M294-294v-372h372v372H294Zm72-72h228v-228H366v228ZM216-216v72q-29.7 0-50.85-21.15Q144-186.3 144-216h72Zm-72-78v-72h72v72h-72Zm0-150v-72h72v72h-72Zm0-150v-72h72v72h-72Zm72-150h-72q0-29.7 21.15-50.85Q186.3-816 216-816v72Zm78 600v-72h72v72h-72Zm0-600v-72h72v72h-72Zm150 600v-72h72v72h-72Zm0-600v-72h72v72h-72Zm150 600v-72h72v72h-72Zm0-600v-72h72v72h-72Zm150 600v-72h72q0 30-21.15 51T744-144Zm0-150v-72h72v72h-72Zm0-150v-72h72v72h-72Zm0-150v-72h72v72h-72Zm0-150v-72q29.7 0 50.85 21.15Q816-773.7 816-744h-72Z</StreamGeometry>
    <StreamGeometry x:Key="MaterialTextCopyIcon">M0-960h0 M960 0h0 M360-240q-29.7 0-50.85-21.15Q288-282.3 288-312v-480q0-29.7 21.15-50.85Q330.3-864 360-864h384q29.7 0 50.85 21.15Q816-821.7 816-792v480q0 29.7-21.15 50.85Q773.7-240 744-240H360Zm0-72h384v-480H360v480ZM216-96q-29.7 0-50.85-21.15Q144-138.3 144-168v-552h72v552h456v72H216Zm144-216v-480 480Z</StreamGeometry>

    <MenuFlyout x:Key="MaterialTextBoxContextFlyout" ShowMode="{OnFormFactor Desktop=Standard, Mobile=Transient}">
        <MenuItem Header="{DynamicResource StringTextFlyoutCutText}" Command="{Binding $parent[TextBox].Cut}"
                  IsEnabled="{Binding $parent[TextBox].CanCut}">
            <controls:MenuAssist.TrailingIcon><PathIcon Width="20" Height="20" Data="{StaticResource MaterialTextCutIcon}" /></controls:MenuAssist.TrailingIcon>
        </MenuItem>
        <MenuItem Header="{DynamicResource StringTextFlyoutCopyText}" Command="{Binding $parent[TextBox].Copy}"
                  IsEnabled="{Binding $parent[TextBox].CanCopy}">
            <controls:MenuAssist.TrailingIcon><PathIcon Width="20" Height="20" Data="{StaticResource MaterialTextCopyIcon}" /></controls:MenuAssist.TrailingIcon>
        </MenuItem>
        <MenuItem Header="{DynamicResource StringTextFlyoutPasteText}" Command="{Binding $parent[TextBox].Paste}"
                  IsEnabled="{Binding $parent[TextBox].CanPaste}">
            <controls:MenuAssist.TrailingIcon><PathIcon Width="20" Height="20" Data="{StaticResource MaterialTextPasteIcon}" /></controls:MenuAssist.TrailingIcon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{DynamicResource StringTextFlyoutSelectAllText}" Command="{Binding $parent[TextBox].SelectAll}"
                  IsEnabled="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <controls:MenuAssist.TrailingIcon><PathIcon Width="20" Height="20" Data="{StaticResource MaterialTextSelectAllIcon}" /></controls:MenuAssist.TrailingIcon>
        </MenuItem>
    </MenuFlyout>

    <!-- Material Web uses a 16dp gap between supporting text and counter. -->
    <tokens:TokenAlias x:Key="MdImplTextFieldSupportingTextGap" ResourceKey="MdSysSpacing200" />

    <converters:TextFieldSupportingTextConverter x:Key="TextFieldSupportingTextConverter" />
    <converters:TextFieldLabelConverter x:Key="TextFieldLabelConverter" />
    <converters:TextFieldScrollPaddingConverter x:Key="TextFieldScrollPaddingConverter" />

    <ControlTheme x:Key="{x:Type TextBox}"
                  TargetType="TextBox">
        <Setter Property="ContextFlyout" Value="{StaticResource MaterialTextBoxContextFlyout}" />
        <Setter Property="internal:HoverState.IsEnabled" Value="True" />

        <!-- Behavior -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <!-- Cursor is inherited, so it covers the whole field. -->
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="helpers:Typography.TextStyle" Value="{x:Null}" />

        <!-- Defaults -->
        <Setter Property="Background" Value="{markup:Token MdCompFilledTextFieldContainerBrush}" />
        <Setter Property="BorderBrush" Value="{markup:Token MdCompFilledTextFieldActiveIndicatorBrush}" />
        <Setter Property="CornerRadius" Value="{markup:Token MdCompFilledTextFieldContainerShape}" />
        <Setter Property="controls:ScrollViewerAssist.ScrollBarInset"
                Value="{Binding $self.CornerRadius, Converter={x:Static converters:ScrollBarConverters.InsetFromCornerRadius}}" />
        <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldInputTextBrush}" />
        <Setter Property="CaretBrush" Value="{markup:Token MdCompFilledTextFieldCaretBrush}" />
        <Setter Property="PlaceholderForeground" Value="{markup:Token MdCompFilledTextFieldInputTextPlaceholderBrush}" />
        <Setter Property="SelectionBrush" Value="{markup:Token MdImplTextSelectionBrush}" />

        <!-- Typography -->
        <Setter Property="FontFamily" Value="{markup:Token MdCompFilledTextFieldInputTextFontFamily}" />
        <Setter Property="FontWeight" Value="{markup:Token MdCompFilledTextFieldInputTextWeight}" />
        <Setter Property="FontSize" Value="{markup:Token MdCompFilledTextFieldInputTextSize}" />
        <Setter Property="LineHeight" Value="{markup:Token MdCompFilledTextFieldInputTextLineHeight}" />
        <Setter Property="LetterSpacing" Value="{markup:Token MdCompFilledTextFieldInputTextTracking}" />

        <!-- Size -->
        <Setter Property="MinHeight"
                Value="{markup:DensityScalar MdCompFilledTextFieldContainerHeight, MostDense=Dense4}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate TargetType="TextBox">
                <DataValidationErrors Theme="{StaticResource MdImplDataValidationErrorsContentOnly}">
                    <Grid x:Name="PART_Root"
                          RowDefinitions="Auto,Auto"
                          MinHeight="{TemplateBinding MinHeight}"
                          Background="Transparent"
                          helpers:Typography.TextStyle="{x:Null}">

                        <primitives:TextFieldHeightAnimator x:Name="PART_FieldHeightAnimator"
                                                            Grid.Row="0">
                            <Grid x:Name="PART_FieldContainer"
                                  MinHeight="{TemplateBinding MinHeight}">

                                <!-- Filled Chrome -->
                                <Border x:Name="PART_FilledContainer"
                                        Grid.Row="0"
                                        IsHitTestVisible="False"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />

                                <primitives:StateLayer x:Name="PART_FilledStateLayer"
                                                       Grid.Row="0"
                                                       IsHitTestVisible="False"
                                                       CornerRadius="{TemplateBinding CornerRadius}"
                                                       Opacity="0" />

                                <primitives:TextFieldIndicatorLine x:Name="PART_FilledIndicator"
                                                                   Grid.Row="0"
                                                                   Brush="{TemplateBinding BorderBrush}" />

                                <!-- Outlined Chrome -->
                                <primitives:NotchedOutline x:Name="PART_OutlinedOutline"
                                                           Grid.Row="0"
                                                           IsVisible="False"
                                                           Stroke="{TemplateBinding BorderBrush}"
                                                           CornerRadius="{TemplateBinding CornerRadius}"
                                                           NotchStart="{Binding #PART_LeadingSection.Bounds.Width}"
                                                           NotchEnd="{Binding #PART_TrailingSection.Bounds.Width}"
                                                           NotchProgress="{Binding #PART_LabelMotion.Progress}">
                                    <!-- NotchedOutline measures its child to size the floating-label gap. -->
                                    <Border x:Name="PART_OutlinedFloatingLabelMotionLayer"
                                            IsVisible="{TemplateBinding controls:TextFieldAssist.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="PART_OutlinedFloatingLabel"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource TextFieldLabelConverter}">
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.Label)" />
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.IsRequired)" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </primitives:NotchedOutline>

                                <!-- Content -->
                                <Grid x:Name="PART_ContentLayout"
                                      Grid.Row="0"
                                      ColumnDefinitions="Auto,*,Auto">

                                    <!-- Leading -->
                                    <StackPanel x:Name="PART_LeadingSection"
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                        <Border x:Name="PART_LeadingSpaceWithoutContent">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="$parent[TextBox].InnerLeftContent"
                                                             Converter="{x:Static ObjectConverters.IsNull}" />
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.LeadingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>

                                        <Border x:Name="PART_LeadingSpaceWithContent">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="$parent[TextBox].InnerLeftContent"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.LeadingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>

                                        <!-- Native Avalonia slot. Arbitrary content remains unconstrained. -->
                                        <ContentPresenter x:Name="PART_LeadingContent"
                                                          Cursor="Arrow"
                                                          VerticalAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          Content="{TemplateBinding InnerLeftContent}"
                                                          IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <Border x:Name="PART_LeadingContentIconSpace">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="$parent[TextBox].InnerLeftContent"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.LeadingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>

                                        <primitives:IconPresenter x:Name="PART_LeadingIcon"
                                                                  IsHitTestVisible="False"
                                                                  VerticalAlignment="Center"
                                                                  Value="{TemplateBinding controls:TextFieldAssist.LeadingIcon}"
                                                                  IsVisible="{TemplateBinding controls:TextFieldAssist.LeadingIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <Border x:Name="PART_LeadingIconInputSpace">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="$parent[TextBox].InnerLeftContent"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.LeadingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>
                                    </StackPanel>

                                    <!-- Text -->
                                    <Grid x:Name="PART_TextLayout"
                                          Grid.Column="1">

                                        <!-- The populated-label reserve keeps filled layout stable without calculated padding. -->
                                        <Grid x:Name="PART_InputVerticalLayout"
                                              RowDefinitions="Auto,Auto,*,Auto">
                                            <Border x:Name="PART_TopSpace"
                                                    Grid.Row="0" />

                                            <Border x:Name="PART_FilledFloatingLabelReserve"
                                                    Grid.Row="1"
                                                    IsVisible="False" />

                                            <Grid x:Name="PART_InputAndRestingLabel"
                                                  Grid.Row="2">

                                                <!-- Prefix + editor + suffix form one logical M3 content row. -->
                                                <Grid x:Name="PART_InputContent"
                                                      ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                                      Opacity="1"
                                                      VerticalAlignment="Stretch">

                                                    <TextBlock x:Name="PART_Prefix"
                                                               Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               Text="{TemplateBinding controls:TextFieldAssist.PrefixText}"
                                                               FontFamily="{TemplateBinding FontFamily}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               LineHeight="{TemplateBinding LineHeight}"
                                                               LetterSpacing="{TemplateBinding LetterSpacing}">
                                                        <TextBlock.IsVisible>
                                                            <Binding Path="$parent[TextBox].(controls:TextFieldAssist.PrefixText)"
                                                                     Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>

                                                    <Border x:Name="PART_PrefixTrailingSpace"
                                                            Grid.Column="1"
                                                            IsVisible="{Binding #PART_Prefix.IsVisible}" />

                                                     <ScrollViewer x:Name="PART_ScrollViewer"
                                                                   Grid.Column="2"
                                                                   controls:ScrollViewerAssist.ScrollBarInset="{Binding Path=$parent[TextBox].(controls:ScrollViewerAssist.ScrollBarInset)}"
                                                                   HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                                                   IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                                                   AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                                                   BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                                                        <ScrollViewer.Padding>
                                                            <MultiBinding Converter="{StaticResource TextFieldScrollPaddingConverter}">
                                                                <Binding Path="#PART_TrailingSection.Bounds.Width" />
                                                                <Binding Path="$parent[TextBox].AcceptsReturn" />
                                                                <Binding Path="$parent[TextBox].TextWrapping" />
                                                            </MultiBinding>
                                                        </ScrollViewer.Padding>

                                                        <Panel>
                                                            <!-- PreeditText keeps IME composition from colliding with placeholder text. -->
                                                            <TextBlock x:Name="PART_Placeholder"
                                                                       IsHitTestVisible="False"
                                                                       Text="{TemplateBinding PlaceholderText}"
                                                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                                                       FontFamily="{TemplateBinding FontFamily}"
                                                                       FontWeight="{TemplateBinding FontWeight}"
                                                                       FontSize="{TemplateBinding FontSize}"
                                                                       LineHeight="{TemplateBinding LineHeight}"
                                                                       LetterSpacing="{TemplateBinding LetterSpacing}"
                                                                       TextAlignment="{TemplateBinding TextAlignment}"
                                                                       TextWrapping="{TemplateBinding TextWrapping}"
                                                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                                                <TextBlock.IsVisible>
                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                        <Binding Path="#PART_TextPresenter.PreeditText"
                                                                                 Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                                        <Binding Path="$parent[TextBox].PlaceholderText"
                                                                                 Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                                    </MultiBinding>
                                                                </TextBlock.IsVisible>
                                                            </TextBlock>

                                                            <!-- Native TextPresenter keeps password, selection, caret and IME behavior. -->
                                                            <TextPresenter x:Name="PART_TextPresenter"
                                                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                                                           CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                                                           CaretIndex="{TemplateBinding CaretIndex}"
                                                                           SelectionStart="{TemplateBinding SelectionStart}"
                                                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                                                           TextAlignment="{TemplateBinding TextAlignment}"
                                                                           TextWrapping="{TemplateBinding TextWrapping}"
                                                                           LineHeight="{TemplateBinding LineHeight}"
                                                                           LetterSpacing="{TemplateBinding LetterSpacing}"
                                                                           PasswordChar="{TemplateBinding PasswordChar}"
                                                                           RevealPassword="{TemplateBinding RevealPassword}"
                                                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                                           CaretBrush="{TemplateBinding CaretBrush}"
                                                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                        </Panel>

                                                        <ScrollViewer.Styles>
                                                            <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                                                                <Setter Property="Cursor" Value="IBeam" />
                                                            </Style>
                                                        </ScrollViewer.Styles>
                                                    </ScrollViewer>

                                                    <Border x:Name="PART_SuffixLeadingSpace"
                                                            Grid.Column="3"
                                                            IsVisible="{Binding #PART_Suffix.IsVisible}" />

                                                    <TextBlock x:Name="PART_Suffix"
                                                               Grid.Column="4"
                                                               VerticalAlignment="Center"
                                                               Text="{TemplateBinding controls:TextFieldAssist.SuffixText}"
                                                               FontFamily="{TemplateBinding FontFamily}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               LineHeight="{TemplateBinding LineHeight}"
                                                               LetterSpacing="{TemplateBinding LetterSpacing}">
                                                        <TextBlock.IsVisible>
                                                            <Binding Path="$parent[TextBox].(controls:TextFieldAssist.SuffixText)"
                                                                     Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>

                                            <Border x:Name="PART_BottomSpace"
                                                    Grid.Row="3" />
                                        </Grid>

                                        <!-- Expanded label endpoint. -->
                                        <Border x:Name="PART_RestingLabelMotionLayer"
                                                IsVisible="{TemplateBinding controls:TextFieldAssist.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Opacity="1"
                                                IsHitTestVisible="False"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="PART_RestingLabel"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource TextFieldLabelConverter}">
                                                        <Binding Path="$parent[TextBox].(controls:TextFieldAssist.Label)" />
                                                        <Binding Path="$parent[TextBox].(controls:TextFieldAssist.IsRequired)" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>

                                        <!-- Filled floating label endpoint. -->
                                        <Grid x:Name="PART_FilledFloatingLabelLayout"
                                              RowDefinitions="Auto,*"
                                              IsHitTestVisible="False">
                                            <Border Grid.Row="0"
                                                    Height="{markup:DensityScalar MdCompFilledTextFieldWithLabelTopSpace, MostDense=Dense2, DeltaScale=0.25}" />
                                            <Border x:Name="PART_FilledFloatingLabelMotionLayer"
                                                    Grid.Row="1"
                                                    IsVisible="{TemplateBinding controls:TextFieldAssist.Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Opacity="0"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Left">
                                                <TextBlock x:Name="PART_FilledFloatingLabel"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource TextFieldLabelConverter}">
                                                            <Binding Path="$parent[TextBox].(controls:TextFieldAssist.Label)" />
                                                            <Binding Path="$parent[TextBox].(controls:TextFieldAssist.IsRequired)" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- Trailing -->
                                    <StackPanel x:Name="PART_TrailingSection"
                                                Grid.Column="2"
                                                Orientation="Horizontal">
                                        <Border x:Name="PART_TrailingIconInputSpace">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.TrailingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                    <Binding Path="$parent[TextBox].InnerRightContent"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>

                                        <primitives:IconPresenter x:Name="PART_TrailingIcon"
                                                                  IsHitTestVisible="False"
                                                                  VerticalAlignment="Center"
                                                                  Value="{TemplateBinding controls:TextFieldAssist.TrailingIcon}"
                                                                  IsVisible="{TemplateBinding controls:TextFieldAssist.TrailingIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <Border x:Name="PART_TrailingIconContentSpace">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.TrailingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                    <Binding Path="$parent[TextBox].InnerRightContent"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>

                                        <ContentPresenter x:Name="PART_TrailingContent"
                                                          Cursor="Arrow"
                                                          VerticalAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          Content="{TemplateBinding InnerRightContent}"
                                                          IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <Border x:Name="PART_TrailingSpaceWithoutContent">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.TrailingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNull}" />
                                                    <Binding Path="$parent[TextBox].InnerRightContent"
                                                             Converter="{x:Static ObjectConverters.IsNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>

                                        <Border x:Name="PART_TrailingSpaceWithContent">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="$parent[TextBox].(controls:TextFieldAssist.TrailingIcon)"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                    <Binding Path="$parent[TextBox].InnerRightContent"
                                                             Converter="{x:Static ObjectConverters.IsNotNull}" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <primitives:TextFieldLabelMotion x:Name="PART_LabelMotion"
                                                                  Grid.Row="0"
                                                                  Width="0"
                                                                  Height="0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Top"
                                                                  Progress="0">
                                    <primitives:TextFieldLabelMotion.ExpandedLabel>
                                        <Binding ElementName="PART_RestingLabelMotionLayer" />
                                    </primitives:TextFieldLabelMotion.ExpandedLabel>
                                    <primitives:TextFieldLabelMotion.FilledMinimizedLabel>
                                        <Binding ElementName="PART_FilledFloatingLabelMotionLayer" />
                                    </primitives:TextFieldLabelMotion.FilledMinimizedLabel>
                                    <primitives:TextFieldLabelMotion.OutlinedMinimizedLabel>
                                        <Binding ElementName="PART_OutlinedFloatingLabelMotionLayer" />
                                    </primitives:TextFieldLabelMotion.OutlinedMinimizedLabel>
                                </primitives:TextFieldLabelMotion>

                            </Grid>
                        </primitives:TextFieldHeightAnimator>

                        <!-- Supporting -->
                        <Grid x:Name="PART_SupportingRow"
                              Grid.Row="1"
                              RowDefinitions="Auto,Auto">
                            <Border x:Name="PART_SupportingTopSpace"
                                    Grid.Row="0" />

                            <Grid x:Name="PART_SupportingContent"
                                  Grid.Row="1"
                                  ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Border x:Name="PART_SupportingLeadingSpace"
                                        Grid.Column="0" />

                                <TextBlock x:Name="PART_SupportingText"
                                           Grid.Column="1"
                                           TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource TextFieldSupportingTextConverter}">
                                            <Binding Path="$parent[TextBox].(controls:TextFieldAssist.IsError)" />
                                            <Binding Path="$parent[TextBox].(controls:TextFieldAssist.ErrorText)" />
                                            <Binding Path="$parent[TextBox].(DataValidationErrors.HasErrors)" />
                                            <Binding Path="$parent[TextBox].(DataValidationErrors.Errors)" />
                                            <Binding Path="$parent[TextBox].(controls:TextFieldAssist.SupportingText)" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.IsVisible>
                                        <Binding Path="$self.Text" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                    </TextBlock.IsVisible>
                                </TextBlock>

                                <Border x:Name="PART_SupportingCounterGap"
                                        Grid.Column="2"
                                        Width="{markup:Token MdImplTextFieldSupportingTextGap}">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="#PART_SupportingText.IsVisible" />
                                            <Binding Path="#PART_CharacterCounter.IsVisible" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>

                                <TextBlock x:Name="PART_CharacterCounter"
                                           Grid.Column="3"
                                           TextAlignment="End"
                                           IsVisible="{Binding !!$parent[TextBox].MaxLength}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} / {1}">
                                            <Binding Path="$parent[TextBox].Text?.Length" FallbackValue="0" TargetNullValue="0" />
                                            <Binding Path="$parent[TextBox].MaxLength" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <Border x:Name="PART_SupportingTrailingSpace"
                                        Grid.Column="4" />
                            </Grid>

                            <Grid.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="#PART_SupportingText.IsVisible" />
                                    <Binding Path="#PART_CharacterCounter.IsVisible" />
                                </MultiBinding>
                            </Grid.IsVisible>
                        </Grid>
                    </Grid>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <!-- Multiline -->

        <!--
            56dp is the M3 minimum container height, not a fixed height.
            Avalonia's TextBox.MeasureOverride sizes PART_ScrollViewer from
            MinLines/MaxLines; never replace MinHeight with Height here.
        -->
        <Style Selector="^[AcceptsReturn=true], ^[TextWrapping=Wrap], ^[TextWrapping=WrapWithOverflow]">
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style Selector="^[AcceptsReturn=true] /template/ Grid#PART_TextLayout, ^[TextWrapping=Wrap] /template/ Grid#PART_TextLayout, ^[TextWrapping=WrapWithOverflow] /template/ Grid#PART_TextLayout">
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>

        <!--
            Prefix/suffix describe the first input line in multiline fields.
            Keep them at the block start instead of vertically centering them
            as the field grows. Leading/trailing content remains arbitrary
            Avalonia content and therefore owns its own alignment.
        -->
        <Style Selector="^[AcceptsReturn=true] /template/ TextBlock#PART_Prefix, ^[AcceptsReturn=true] /template/ TextBlock#PART_Suffix, ^[TextWrapping=Wrap] /template/ TextBlock#PART_Prefix, ^[TextWrapping=Wrap] /template/ TextBlock#PART_Suffix, ^[TextWrapping=WrapWithOverflow] /template/ TextBlock#PART_Prefix, ^[TextWrapping=WrapWithOverflow] /template/ TextBlock#PART_Suffix">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Motion -->

        <!-- Label Position -->
        <Style Selector="^ /template/ primitives|TextFieldLabelMotion#PART_LabelMotion">
            <Setter Property="Transitions">
                <Transitions>
                    <transitions:SpringDoubleTransition Property="Progress"
                                                        Style="Spatial"
                                                        Speed="Fast" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Label Color -->
        <Style Selector="^ /template/ TextBlock#PART_RestingLabel, ^ /template/ TextBlock#PART_FilledFloatingLabel, ^ /template/ TextBlock#PART_OutlinedFloatingLabel">
            <Setter Property="Transitions">
                <Transitions>
                    <transitions:SpringBrushTransition Property="Foreground"
                                                       Style="Effects"
                                                       Speed="Fast" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Affix Opacity -->
        <Style Selector="^ /template/ TextBlock#PART_Prefix, ^ /template/ TextBlock#PART_Suffix">
            <Setter Property="Transitions">
                <Transitions>
                    <transitions:SpringDoubleTransition Property="Opacity"
                                                        Style="Effects"
                                                        Speed="Fast" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Placeholder Opacity -->
        <Style Selector="^ /template/ TextBlock#PART_Placeholder">
            <Setter Property="Transitions">
                <Transitions>
                    <transitions:SpringDirectionalDoubleTransition Property="Opacity"
                                                                   IncreaseStyle="Effects"
                                                                   IncreaseSpeed="Slow"
                                                                   DecreaseStyle="Effects"
                                                                   DecreaseSpeed="Fast" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Expanded Label -->
        <Style Selector="^.m3-text-field-has-label:empty:not(:focus) /template/ TextBlock#PART_Prefix, ^.m3-text-field-has-label:empty:not(:focus) /template/ TextBlock#PART_Suffix, ^.m3-text-field-has-label:empty:not(:focus) /template/ TextBlock#PART_Placeholder">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Placeholder is never shown over populated input. -->
        <Style Selector="^:not(:empty) /template/ TextBlock#PART_Placeholder">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Floating Label -->
        <Style Selector="^.m3-text-field-has-label:focus /template/ primitives|TextFieldLabelMotion#PART_LabelMotion, ^.m3-text-field-has-label:not(:empty) /template/ primitives|TextFieldLabelMotion#PART_LabelMotion">
            <Setter Property="Progress" Value="1" />
        </Style>

        <!--
            A labelled Filled field always keeps the minimized-label slot in layout.
            Focus/population now changes only rendering (label progress/content opacity), never measure.
        -->
        <Style Selector="^.m3-text-field-has-label[(controls|TextFieldAssist.Variant)=Filled] /template/ Border#PART_FilledFloatingLabelReserve">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Height"
                    Value="{markup:DensityScalar MdCompFilledTextFieldLabelTextPopulatedLineHeight, MostDense=Dense2, DeltaScale=0.5}" />
        </Style>

        <!-- Outlined Label Motion -->
        <Style Selector="^[(controls|TextFieldAssist.Variant)=Outlined] /template/ primitives|TextFieldLabelMotion#PART_LabelMotion">
            <Setter Property="IsOutlined" Value="True" />
        </Style>

        <!-- Disabled Label -->
        <Style Selector="^.m3-text-field-has-label:disabled:empty /template/ Grid#PART_InputContent">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Variant: Filled -->
        <Style Selector="^[(controls|TextFieldAssist.Variant)=Filled]">
            <Setter Property="Background" Value="{markup:Token MdCompFilledTextFieldContainerBrush}" />
            <Setter Property="BorderBrush" Value="{markup:Token MdCompFilledTextFieldActiveIndicatorBrush}" />
            <Setter Property="CornerRadius" Value="{markup:Token MdCompFilledTextFieldContainerShape}" />
            <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldInputTextBrush}" />
            <Setter Property="CaretBrush" Value="{markup:Token MdCompFilledTextFieldCaretBrush}" />
            <Setter Property="PlaceholderForeground" Value="{markup:Token MdCompFilledTextFieldInputTextPlaceholderBrush}" />
            <Setter Property="FontFamily" Value="{markup:Token MdCompFilledTextFieldInputTextFontFamily}" />
            <Setter Property="FontWeight" Value="{markup:Token MdCompFilledTextFieldInputTextWeight}" />
            <Setter Property="FontSize" Value="{markup:Token MdCompFilledTextFieldInputTextSize}" />
            <Setter Property="LineHeight" Value="{markup:Token MdCompFilledTextFieldInputTextLineHeight}" />
            <Setter Property="LetterSpacing" Value="{markup:Token MdCompFilledTextFieldInputTextTracking}" />
            <Setter Property="MinHeight"
                    Value="{markup:DensityScalar MdCompFilledTextFieldContainerHeight, MostDense=Dense4}" />

            <Style Selector="^.m3-text-field-has-label">
                <Setter Property="MinHeight"
                        Value="{markup:DensityScalar MdCompFilledTextFieldContainerHeight, MostDense=Dense2}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_FilledContainer">
                <Setter Property="IsVisible" Value="True" />
            </Style>

            <Style Selector="^ /template/ primitives|StateLayer#PART_FilledStateLayer">
                <Setter Property="IsVisible" Value="True" />
            </Style>

            <Style Selector="^ /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Thickness" Value="{markup:Token MdCompFilledTextFieldActiveIndicatorHeight}" />
                <Setter Property="Transitions">
                    <Transitions>
                        <transitions:SpringBrushTransition Property="Brush" Style="Effects" Speed="Fast" />
                        <transitions:SpringDoubleTransition Property="Thickness" Style="Spatial" Speed="Fast" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="^ /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ Border#PART_LeadingSpaceWithoutContent">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldLeadingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_LeadingSpaceWithContent">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldWithLeadingIconLeadingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_LeadingIconInputSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldIconInputSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_LeadingContentIconSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldIconInputSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_TrailingIconInputSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldIconInputSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_TrailingIconContentSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldIconInputSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_TrailingSpaceWithoutContent">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldTrailingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_TrailingSpaceWithContent">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldWithTrailingIconTrailingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_TopSpace">
                <Setter Property="Height"
                        Value="{markup:DensityScalar MdCompFilledTextFieldTopSpace, MostDense=Dense4, DeltaScale=0.5}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_BottomSpace">
                <Setter Property="Height"
                        Value="{markup:DensityScalar MdCompFilledTextFieldBottomSpace, MostDense=Dense4, DeltaScale=0.5}" />
            </Style>

            <!-- Labelled fields distribute density across top, label, and bottom slots. -->
            <Style Selector="^.m3-text-field-has-label /template/ Border#PART_TopSpace">
                <Setter Property="Height"
                        Value="{markup:DensityScalar MdCompFilledTextFieldWithLabelTopSpace, MostDense=Dense2, DeltaScale=0.25}" />
            </Style>

            <Style Selector="^.m3-text-field-has-label /template/ Border#PART_BottomSpace">
                <Setter Property="Height"
                        Value="{markup:DensityScalar MdCompFilledTextFieldWithLabelBottomSpace, MostDense=Dense2, DeltaScale=0.25}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_PrefixTrailingSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldInputTextPrefixTrailingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SuffixLeadingSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldInputTextSuffixLeadingSpace}" />
            </Style>

            <Style Selector="^ /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldLeadingIconBrush}" />
            </Style>

            <Style Selector="^ /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldLeadingIconBrush}" />
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldLeadingIconSize}" />
                <Setter Property="Height" Value="{markup:Token MdCompFilledTextFieldLeadingIconSize}" />
            </Style>

            <Style Selector="^ /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldTrailingIconBrush}" />
            </Style>

            <Style Selector="^ /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldTrailingIconBrush}" />
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldTrailingIconSize}" />
                <Setter Property="Height" Value="{markup:Token MdCompFilledTextFieldTrailingIconSize}" />
            </Style>

            <Style Selector="^ /template/ TextBlock#PART_RestingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldLabelTextBrush}" />
                <Setter Property="FontFamily" Value="{markup:Token MdCompFilledTextFieldLabelTextFontFamily}" />
                <Setter Property="FontWeight" Value="{markup:Token MdCompFilledTextFieldLabelTextWeight}" />
                <Setter Property="FontSize" Value="{markup:Token MdCompFilledTextFieldLabelTextSize}" />
                <Setter Property="LineHeight" Value="{markup:Token MdCompFilledTextFieldLabelTextLineHeight}" />
                <Setter Property="LetterSpacing" Value="{markup:Token MdCompFilledTextFieldLabelTextTracking}" />
            </Style>

            <Style Selector="^ /template/ TextBlock#PART_FilledFloatingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldLabelTextBrush}" />
                <Setter Property="FontFamily" Value="{markup:Token MdCompFilledTextFieldLabelTextFontFamily}" />
                <Setter Property="FontWeight" Value="{markup:Token MdCompFilledTextFieldLabelTextWeight}" />
                <Setter Property="FontSize" Value="{markup:Token MdCompFilledTextFieldLabelTextPopulatedSize}" />
                <Setter Property="LineHeight" Value="{markup:Token MdCompFilledTextFieldLabelTextPopulatedLineHeight}" />
                <Setter Property="LetterSpacing" Value="{markup:Token MdCompFilledTextFieldLabelTextTracking}" />
            </Style>

            <Style Selector="^ /template/ TextBlock#PART_Prefix">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldInputTextPrefixBrush}" />
            </Style>

            <Style Selector="^ /template/ TextBlock#PART_Suffix">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldInputTextSuffixBrush}" />
            </Style>

            <!-- Supporting row uses Filled component tokens. -->
            <Style Selector="^ /template/ Border#PART_SupportingTopSpace">
                <Setter Property="Height" Value="{markup:Token MdCompFilledTextFieldSupportingTextTopSpace}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_SupportingLeadingSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldSupportingTextLeadingSpace}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_SupportingTrailingSpace">
                <Setter Property="Width" Value="{markup:Token MdCompFilledTextFieldSupportingTextTrailingSpace}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_SupportingText, ^ /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldSupportingTextBrush}" />
                <Setter Property="FontFamily" Value="{markup:Token MdCompFilledTextFieldSupportingTextFontFamily}" />
                <Setter Property="FontWeight" Value="{markup:Token MdCompFilledTextFieldSupportingTextWeight}" />
                <Setter Property="FontSize" Value="{markup:Token MdCompFilledTextFieldSupportingTextSize}" />
                <Setter Property="LineHeight" Value="{markup:Token MdCompFilledTextFieldSupportingTextLineHeight}" />
                <Setter Property="LetterSpacing" Value="{markup:Token MdCompFilledTextFieldSupportingTextTracking}" />
            </Style>

            <!-- Hover: the state layer remains visible while focused; focus colors still override content colors. -->
            <Style Selector="^.m3-hovered:not(:disabled) /template/ primitives|StateLayer#PART_FilledStateLayer">
                <Setter Property="Brush" Value="{markup:Token MdCompFilledTextFieldHoverStateLayerBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompFilledTextFieldHoverStateLayerOpacity}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator">
                <Setter Property="Brush" Value="{markup:Token MdCompFilledTextFieldHoverActiveIndicatorBrush}" />
                <Setter Property="Thickness" Value="{markup:Token MdCompFilledTextFieldHoverActiveIndicatorHeight}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldHoverInputTextBrush}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_RestingLabel, ^.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_FilledFloatingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldHoverLabelTextBrush}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldHoverLeadingIconBrush}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldHoverLeadingIconBrush}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldHoverTrailingIconBrush}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldHoverTrailingIconBrush}" />
            </Style>
            <Style Selector="^.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_SupportingText, ^.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldHoverSupportingTextBrush}" />
            </Style>

            <!-- Focus. -->
            <Style Selector="^:focus:not(:disabled) /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldFocusInputTextBrush}" />
                <Setter Property="CaretBrush" Value="{markup:Token MdCompFilledTextFieldFocusCaretBrush}" />
            </Style>
            <Style Selector="^:focus:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^:focus:not(:disabled) /template/ TextBlock#PART_FilledFloatingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldFocusLabelTextBrush}" />
            </Style>
            <Style Selector="^:focus:not(:disabled) /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldFocusLeadingIconBrush}" />
            </Style>
            <Style Selector="^:focus:not(:disabled) /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldFocusLeadingIconBrush}" />
            </Style>
            <Style Selector="^:focus:not(:disabled) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldFocusTrailingIconBrush}" />
            </Style>
            <Style Selector="^:focus:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldFocusTrailingIconBrush}" />
            </Style>
            <Style Selector="^:focus:not(:disabled) /template/ TextBlock#PART_SupportingText, ^:focus:not(:disabled) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldFocusSupportingTextBrush}" />
            </Style>
            <Style Selector="^:focus:not(:disabled) /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator">
                <Setter Property="Brush" Value="{markup:Token MdCompFilledTextFieldFocusActiveIndicatorBrush}" />
                <Setter Property="Thickness" Value="{markup:Token MdCompFilledTextFieldFocusActiveIndicatorHeight}" />
            </Style>

            <!-- Error: native Avalonia :error OR manual TextFieldAssist.IsError. -->
            <Style Selector="^:error:not(:disabled) /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator, ^.m3-text-field-manual-error:not(:disabled) /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator">
                <Setter Property="Brush" Value="{markup:Token MdCompFilledTextFieldErrorActiveIndicatorBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ TextPresenter#PART_TextPresenter, ^.m3-text-field-manual-error:not(:disabled) /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldErrorInputTextBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^:error:not(:disabled) /template/ TextBlock#PART_FilledFloatingLabel, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_FilledFloatingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldErrorLabelTextBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ ContentPresenter#PART_LeadingContent, ^.m3-text-field-manual-error:not(:disabled) /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldErrorLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ primitives|IconPresenter#PART_LeadingIcon, ^.m3-text-field-manual-error:not(:disabled) /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldErrorLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ ContentPresenter#PART_TrailingContent, ^.m3-text-field-manual-error:not(:disabled) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldErrorTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon, ^.m3-text-field-manual-error:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldErrorTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ TextBlock#PART_SupportingText, ^:error:not(:disabled) /template/ TextBlock#PART_CharacterCounter, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_SupportingText, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldErrorSupportingTextBrush}" />
            </Style>

            <!-- Error + Hover. -->
            <Style Selector="^:error.m3-hovered:not(:disabled):not(:focus) /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator">
                <Setter Property="Brush" Value="{markup:Token MdCompFilledTextFieldErrorHoverActiveIndicatorBrush}" />
                <Setter Property="Thickness" Value="{markup:Token MdCompFilledTextFieldHoverActiveIndicatorHeight}" />
            </Style>
            <Style Selector="^:error.m3-hovered:not(:disabled) /template/ primitives|StateLayer#PART_FilledStateLayer, ^.m3-hovered:error:not(:disabled) /template/ primitives|StateLayer#PART_FilledStateLayer, ^.m3-text-field-manual-error.m3-hovered:not(:disabled) /template/ primitives|StateLayer#PART_FilledStateLayer">
                <Setter Property="Brush" Value="{markup:Token MdCompFilledTextFieldErrorHoverStateLayerBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompFilledTextFieldErrorHoverStateLayerOpacity}" />
            </Style>
            <Style Selector="^:error.m3-hovered:not(:disabled):not(:focus) /template/ TextPresenter#PART_TextPresenter, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldErrorHoverInputTextBrush}" />
            </Style>
            <Style Selector="^:error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_RestingLabel, ^:error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_FilledFloatingLabel, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_RestingLabel, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_FilledFloatingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompFilledTextFieldErrorHoverLabelTextBrush}" />
            </Style>
            <Style Selector="^:error.m3-hovered:not(:disabled):not(:focus) /template/ ContentPresenter#PART_LeadingContent, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompFilledTextFieldErrorHoverLeadingIconBrush}" />
            </Style>
