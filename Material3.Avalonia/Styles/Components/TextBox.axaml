                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_LeadingIcon, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ ContentPresenter#PART_TrailingContent, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ TextBlock#PART_SupportingText, ^:error:focus:not(:disabled) /template/ TextBlock#PART_CharacterCounter, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_SupportingText, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusSupportingTextBrush}" />
            </Style>

            <!-- Disabled. -->
            <Style Selector="^:disabled /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="Stroke" Value="{DynamicResource MdCompOutlinedTextFieldDisabledOutlineBrush}" />
                <Setter Property="StrokeThickness" Value="{DynamicResource MdCompOutlinedTextFieldDisabledOutlineWidth}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledOutlineOpacity}" />
                <Setter Property="Transitions" Value="{x:Null}" />
            </Style>
            <Style Selector="^:disabled /template/ Grid#PART_InputContent">
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledInputTextOpacity}" />
            </Style>
            <Style Selector="^.m3-text-field-has-label:disabled:empty /template/ Grid#PART_InputContent">
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="^:disabled /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledInputTextBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ TextBlock#PART_Placeholder, ^:disabled /template/ TextBlock#PART_Prefix, ^:disabled /template/ TextBlock#PART_Suffix">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledInputTextBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledLeadingIconBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledLeadingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledLeadingIconBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledLeadingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledTrailingIconBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledTrailingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledTrailingIconBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledTrailingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ TextBlock#PART_SupportingText, ^:disabled /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledSupportingTextBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledSupportingTextOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ TextBlock#PART_RestingLabel, ^:disabled /template/ TextBlock#PART_OutlinedFloatingLabel">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldDisabledLabelTextBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompOutlinedTextFieldDisabledLabelTextOpacity}" />
            </Style>
        </Style>

        <!-- Classes -->

        <!-- Variant -->
        <Style Selector="^.filled">
            <Setter Property="controls:TextFieldAssist.Variant" Value="Filled" />
        </Style>

        <Style Selector="^.outlined">
            <Setter Property="controls:TextFieldAssist.Variant" Value="Outlined" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
