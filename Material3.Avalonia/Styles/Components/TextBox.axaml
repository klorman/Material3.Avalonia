            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ ContentPresenter#PART_LeadingContent, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorHoverLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_LeadingIcon, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorHoverLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ ContentPresenter#PART_TrailingContent, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorHoverTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_TrailingIcon, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_TrailingIcon">
