            <!-- Supporting row uses Outlined component tokens. -->
            <Style Selector="^ /template/ Border#PART_SupportingTopSpace">
                <Setter Property="Height" Value="{DynamicResource MdCompOutlinedTextFieldSupportingTextTopSpace}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_SupportingLeadingSpace">
