            <Style Selector="^:error:focus:not(:disabled) /template/ TextPresenter#PART_TextPresenter, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusInputTextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource MdCompOutlinedTextFieldErrorFocusCaretBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^:error:focus:not(:disabled) /template/ TextBlock#PART_OutlinedFloatingLabel, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_OutlinedFloatingLabel">
