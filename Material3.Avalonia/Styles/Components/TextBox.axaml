                <Setter Property="Opacity" Value="{DynamicResource MdCompFilledTextFieldDisabledLeadingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{DynamicResource MdCompFilledTextFieldDisabledLeadingIconBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompFilledTextFieldDisabledLeadingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_TrailingContent">
