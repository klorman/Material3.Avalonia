            </Style>
            <Style Selector="^:error.m3-hovered:not(:disabled):not(:focus) /template/ ContentPresenter#PART_TrailingContent, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorHoverTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error.m3-hovered:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_TrailingIcon, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorHoverTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_SupportingText, ^:error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_CharacterCounter, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_SupportingText, ^.m3-text-field-manual-error.m3-hovered:not(:disabled):not(:focus) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorHoverSupportingTextBrush}" />
            </Style>

            <!-- Error + Focus. -->
            <Style Selector="^:error:focus:not(:disabled) /template/ primitives|NotchedOutline#PART_OutlinedOutline, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="Stroke" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusOutlineBrush}" />
                <Setter Property="StrokeThickness" Value="{markup:Token MdCompOutlinedTextFieldFocusOutlineWidth}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ TextPresenter#PART_TextPresenter, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusInputTextBrush}" />
                <Setter Property="CaretBrush" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusCaretBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^:error:focus:not(:disabled) /template/ TextBlock#PART_OutlinedFloatingLabel, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_OutlinedFloatingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusLabelTextBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ ContentPresenter#PART_LeadingContent, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_LeadingIcon, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusLeadingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ ContentPresenter#PART_TrailingContent, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusTrailingIconBrush}" />
            </Style>
            <Style Selector="^:error:focus:not(:disabled) /template/ TextBlock#PART_SupportingText, ^:error:focus:not(:disabled) /template/ TextBlock#PART_CharacterCounter, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_SupportingText, ^.m3-text-field-manual-error:focus:not(:disabled) /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldErrorFocusSupportingTextBrush}" />
            </Style>

            <!-- Disabled. -->
            <Style Selector="^:disabled /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="Stroke" Value="{markup:Token MdCompOutlinedTextFieldDisabledOutlineBrush}" />
                <Setter Property="StrokeThickness" Value="{markup:Token MdCompOutlinedTextFieldDisabledOutlineWidth}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledOutlineOpacity}" />
                <Setter Property="Transitions" Value="{x:Null}" />
            </Style>
            <Style Selector="^:disabled /template/ Grid#PART_InputContent">
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledInputTextOpacity}" />
            </Style>
            <Style Selector="^.m3-text-field-has-label:disabled:empty /template/ Grid#PART_InputContent">
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="^:disabled /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledInputTextBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ TextBlock#PART_Placeholder, ^:disabled /template/ TextBlock#PART_Prefix, ^:disabled /template/ TextBlock#PART_Suffix">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledInputTextBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledLeadingIconBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledLeadingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ primitives|IconPresenter#PART_LeadingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledLeadingIconBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledLeadingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_TrailingContent">
                <Setter Property="TextElement.Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledTrailingIconBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledTrailingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ primitives|IconPresenter#PART_TrailingIcon">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledTrailingIconBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledTrailingIconOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ TextBlock#PART_SupportingText, ^:disabled /template/ TextBlock#PART_CharacterCounter">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledSupportingTextBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledSupportingTextOpacity}" />
            </Style>
            <Style Selector="^:disabled /template/ TextBlock#PART_RestingLabel, ^:disabled /template/ TextBlock#PART_OutlinedFloatingLabel">
                <Setter Property="Foreground" Value="{markup:Token MdCompOutlinedTextFieldDisabledLabelTextBrush}" />
                <Setter Property="Opacity" Value="{markup:Token MdCompOutlinedTextFieldDisabledLabelTextOpacity}" />
            </Style>
        </Style>



        <!-- Classes -->

        <!-- Variant -->
        <Style Selector="^.filled">
            <Setter Property="controls:TextFieldAssist.Variant" Value="Filled" />
        </Style>

        <Style Selector="^.outlined">
            <Setter Property="controls:TextFieldAssist.Variant" Value="Outlined" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
