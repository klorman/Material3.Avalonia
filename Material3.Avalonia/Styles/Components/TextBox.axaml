            </Style>

            <Style Selector="^ /template/ Border#PART_TrailingSpaceWithContent">
                <Setter Property="Width" Value="{DynamicResource MdCompOutlinedTextFieldWithTrailingIconTrailingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_TopSpace">
                <Setter Property="Height" Value="{DynamicResource MdCompOutlinedTextFieldTopSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_BottomSpace">
                <Setter Property="Height" Value="{DynamicResource MdCompOutlinedTextFieldBottomSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_PrefixTrailingSpace">
