                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorInputTextBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^:error:not(:disabled) /template/ TextBlock#PART_OutlinedFloatingLabel, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_RestingLabel, ^.m3-text-field-manual-error:not(:disabled) /template/ TextBlock#PART_OutlinedFloatingLabel">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorLabelTextBrush}" />
            </Style>
            <Style Selector="^:error:not(:disabled) /template/ ContentPresenter#PART_LeadingContent, ^.m3-text-field-manual-error:not(:disabled) /template/ ContentPresenter#PART_LeadingContent">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorLeadingIconBrush}" />
