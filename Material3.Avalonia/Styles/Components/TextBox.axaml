            <Style Selector="^:disabled /template/ TextBlock#PART_RestingLabel, ^:disabled /template/ TextBlock#PART_FilledFloatingLabel">
                <Setter Property="Foreground" Value="{DynamicResource MdCompFilledTextFieldDisabledLabelTextBrush}" />
                <Setter Property="Opacity" Value="{DynamicResource MdCompFilledTextFieldDisabledLabelTextOpacity}" />
            </Style>
        </Style>

        <!-- Variant: Outlined -->
        <Style Selector="^[(controls|TextFieldAssist.Variant)=Outlined]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MdCompOutlinedTextFieldOutlineBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource MdCompOutlinedTextFieldContainerShape}" />
            <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldInputTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource MdCompOutlinedTextFieldCaretBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource MdCompOutlinedTextFieldInputTextPlaceholderBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource MdCompOutlinedTextFieldInputTextFontFamily}" />
            <Setter Property="FontWeight" Value="{DynamicResource MdCompOutlinedTextFieldInputTextWeight}" />
            <Setter Property="FontSize" Value="{DynamicResource MdCompOutlinedTextFieldInputTextSize}" />
            <Setter Property="LineHeight" Value="{DynamicResource MdCompOutlinedTextFieldInputTextLineHeight}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource MdCompOutlinedTextFieldInputTextTracking}" />
            <Setter Property="MinHeight" Value="{DynamicResource MdCompOutlinedTextFieldContainerHeight}" />

            <Style Selector="^ /template/ Border#PART_FilledContainer">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ primitives|StateLayer#PART_FilledStateLayer">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ primitives|TextFieldIndicatorLine#PART_FilledIndicator">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="StrokeThickness" Value="{DynamicResource MdCompOutlinedTextFieldOutlineWidth}" />
                <Setter Property="NotchPadding" Value="{DynamicResource MdCompOutlinedTextFieldOutlineLabelPadding}" />
                <Setter Property="LabelBottomPadding" Value="{DynamicResource MdCompOutlinedTextFieldLabelTextPaddingBottom}" />
                <Setter Property="Transitions">
                    <Transitions>
                        <transitions:SpringBrushTransition Property="Stroke" Style="Effects" Speed="Fast" />
                        <transitions:SpringDoubleTransition Property="StrokeThickness" Style="Spatial" Speed="Fast" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="^ /template/ Border#PART_LeadingSpaceWithoutContent">
                <Setter Property="Width" Value="{DynamicResource MdCompOutlinedTextFieldLeadingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_LeadingSpaceWithContent">
                <Setter Property="Width" Value="{DynamicResource MdCompOutlinedTextFieldWithLeadingIconLeadingSpace}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_LeadingIconInputSpace">
