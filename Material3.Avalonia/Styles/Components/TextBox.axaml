            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ TextPresenter#PART_TextPresenter, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorHoverInputTextBrush}" />
            </Style>
            <Style Selector="^:error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_RestingLabel, ^:error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_OutlinedFloatingLabel, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_RestingLabel, ^.m3-text-field-manual-error:pointerover:not(:disabled):not(:focus) /template/ TextBlock#PART_OutlinedFloatingLabel">
                <Setter Property="Foreground" Value="{DynamicResource MdCompOutlinedTextFieldErrorHoverLabelTextBrush}" />
