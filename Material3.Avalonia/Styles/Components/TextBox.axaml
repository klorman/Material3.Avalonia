            <!-- Focus. -->
            <Style Selector="^:focus:not(:disabled) /template/ primitives|NotchedOutline#PART_OutlinedOutline">
                <Setter Property="Stroke" Value="{DynamicResource MdCompOutlinedTextFieldFocusOutlineBrush}" />
