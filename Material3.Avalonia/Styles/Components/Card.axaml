<ResourceDictionary xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:Material3.Avalonia.Controls"
                      xmlns:converters="clr-namespace:Material3.Avalonia.Converters"
                      xmlns:markup="clr-namespace:Material3.Avalonia.Markup"
                      xmlns:primitives="clr-namespace:Material3.Avalonia.Controls.Primitives"
                     xmlns:attachedControls="clr-namespace:Material3.Avalonia.Attached.Controls"
                     xmlns:attached="clr-namespace:Material3.Avalonia.Attached">
    <ControlTheme x:Key="{x:Type controls:Card}" TargetType="controls:Card">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Focusable" Value="{Binding $self.IsInteractive}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MdSysShapeCornerMedium}" />
        <Setter Property="Padding" Value="{markup:DynamicThickness MdCompCardContentLeadingSpace MdCompCardContentTopSpace MdCompCardContentTrailingSpace MdCompCardContentBottomSpace}" />
        <Setter Property="attachedControls:ScrollViewerAssist.ScrollBarInset"
                Value="{Binding $self.CornerRadius, Converter={x:Static converters:ScrollBarConverters.InsetFromCornerRadius}}" />
        <Setter Property="attached:FocusRing.Thickness" Value="{DynamicResource MdCompCardFocusRingThickness}" />
        <Setter Property="attached:FocusRing.Offset" Value="{DynamicResource MdCompCardFocusRingOffset}" />
        <Setter Property="attached:FocusRing.CornerRadius" Value="{Binding $self.CornerRadius}" />
        <Setter Property="attached:FocusRing.Brush" Value="{DynamicResource MdCompCardFocusRingBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="PART_Container"
                      ClipToBounds="{TemplateBinding ClipToBounds}">
                    <Border x:Name="PART_Outline"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="PART_Background"
                                Background="{TemplateBinding Background}"
                                Opacity="1"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </Border>

                    <primitives:StateLayer x:Name="PART_StateLayer"
                                           CornerRadius="{TemplateBinding CornerRadius}"
                                           Brush="{DynamicResource MdCompCardStateLayerBrush}"
                                           Opacity="0" />

                    <ContentPresenter x:Name="PART_Content"
                                      Margin="{TemplateBinding Padding}"
                                       Content="{TemplateBinding Content}" />

                    <primitives:InkRipple x:Name="PART_Ripple"
                                          IsVisible="{TemplateBinding IsInteractive}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Brush="{DynamicResource MdCompCardStateLayerBrush}"
                                          BaseOpacity="{DynamicResource MdSysStatePressedOpacity}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- State -->
        <Style Selector="^[IsInteractive=True]:focus-visible:not(:disabled) /template/ primitives|StateLayer#PART_StateLayer">
            <Setter Property="Opacity" Value="{DynamicResource MdSysStateFocusOpacity}" />
        </Style>

        <Style Selector="^[IsInteractive=True]:pointerover:not(:disabled) /template/ primitives|StateLayer#PART_StateLayer">
            <Setter Property="Opacity" Value="{DynamicResource MdSysStatePointerOverOpacity}" />
        </Style>

        <!-- Variant -->
        <Style Selector="^[Variant=Elevated]">
            <Setter Property="Background" Value="{DynamicResource MdCompCardElevatedContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MdCompCardOnElevatedContainerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style Selector="^ /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel1}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:focus-visible /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel1}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:pointerover:not(:pressed):not(:disabled) /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:pressed /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel1}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{DynamicResource MdCompCardElevatedDisabledContainerBrush}" />
                <Style Selector="^ /template/ Border#PART_Outline">
                    <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel1}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Outline">
                    <Setter Property="Opacity" Value="{DynamicResource MdCompCardElevatedDisabledContainerOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{x:Null}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[Variant=Filled]">
            <Setter Property="Background" Value="{DynamicResource MdCompCardFilledContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MdCompCardOnFilledContainerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style Selector="^ /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:focus-visible /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:pointerover:not(:pressed):not(:disabled) /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel1}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:pressed /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{DynamicResource MdCompCardFilledDisabledContainerBrush}" />
                <Style Selector="^ /template/ Border#PART_Outline">
                    <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Background">
                    <Setter Property="Opacity" Value="{DynamicResource MdCompCardFilledDisabledContainerOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{x:Null}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[Variant=Outlined]">
            <Setter Property="Background" Value="{DynamicResource MdCompCardOutlinedContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MdCompCardOnOutlinedContainerBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource MdCompCardOutlinedOutlineThickness}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MdCompCardOutlinedOutlineBrush}" />
            <Style Selector="^ /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:focus-visible /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:pointerover:not(:pressed):not(:disabled) /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel1}" />
            </Style>
            <Style Selector="^[IsInteractive=True]:pressed /template/ Border#PART_Outline">
                <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="BorderBrush" Value="{DynamicResource MdCompCardOutlinedDisabledOutlineBrush}" />
                <Style Selector="^ /template/ Border#PART_Outline">
                    <Setter Property="BoxShadow" Value="{DynamicResource MdSysShadowLevel0}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Outline">
                    <Setter Property="Opacity" Value="{DynamicResource MdCompCardOutlinedDisabledOutlineOpacity}" />
                </Style>
                <Style Selector="^ /template/ primitives|InkRipple#PART_Ripple">
                    <Setter Property="Brush" Value="{x:Null}" />
                </Style>
            </Style>
        </Style>

        <!-- Classes -->

        <!-- Variant -->
        <Style Selector="^.elevated">
            <Setter Property="Variant" Value="Elevated" />
        </Style>

        <Style Selector="^.filled">
            <Setter Property="Variant" Value="Filled" />
        </Style>

        <Style Selector="^.outlined">
            <Setter Property="Variant" Value="Outlined" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
