<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Material3.Avalonia.Demo/Material3.Avalonia.Demo.csproj" />
        <ProjectReference Include="../Material3.Avalonia.Fonts.Roboto/Material3.Avalonia.Fonts.Roboto.csproj" />
        <PackageReference Include="Avalonia.Browser" Version="12.1.2" />
        <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
