<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net472</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <BuildInParallel>false</BuildInParallel>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" Version="17.8.43" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.43" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.3" PrivateAssets="all" GeneratePathProperty="true" />
    </ItemGroup>
    <ItemGroup>
        <None Include="$(PkgHarfBuzzSharp_NativeAssets_Linux)/runtimes/**/*"
              Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
        <None Include="$(PkgHarfBuzzSharp_NativeAssets_Win32)/runtimes/**/*"
              Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
        <None Include="$(PkgHarfBuzzSharp_NativeAssets_macOS)/runtimes/**/*"
              Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
        <Material3Net472HarfBuzzArchitecture Condition="'$(MSBuildArchitecture)' == 'x86'">x86</Material3Net472HarfBuzzArchitecture>
        <Material3Net472HarfBuzzArchitecture Condition="'$(MSBuildArchitecture)' == 'arm64'">arm64</Material3Net472HarfBuzzArchitecture>
        <Material3Net472HarfBuzzArchitecture Condition="'$(Material3Net472HarfBuzzArchitecture)' == ''">x64</Material3Net472HarfBuzzArchitecture>
        <Material3Net472HarfBuzzSource>$(PkgHarfBuzzSharp_NativeAssets_Win32)/runtimes/win-$(Material3Net472HarfBuzzArchitecture)/native/libHarfBuzzSharp.dll</Material3Net472HarfBuzzSource>
    </PropertyGroup>

    <Target Name="Material3CopyNet472HarfBuzzNative"
            AfterTargets="Build"
            Condition="'$(TargetFramework)' == 'net472'">
        <Error Condition="!Exists('$(Material3Net472HarfBuzzSource)')"
               Text="Cannot find the HarfBuzz native asset for MSBuild architecture '$(MSBuildArchitecture)' at '$(Material3Net472HarfBuzzSource)'." />
        <Copy SourceFiles="$(Material3Net472HarfBuzzSource)"
              DestinationFolder="$(TargetDir)"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
