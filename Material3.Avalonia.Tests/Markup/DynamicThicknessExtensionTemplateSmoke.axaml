<Button xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:Material3.Avalonia.Markup"
        xmlns:tokens="using:Material3.Avalonia.Tokens"
        Theme="{StaticResource ReproTheme}">
    <Button.Resources>
        <ResourceDictionary>
            <tokens:TokenAlias x:Key="NormalPadding" ResourceKey="NormalPaddingLeaf" />
            <tokens:TokenAlias x:Key="FocusPadding" ResourceKey="FocusPaddingLeaf" />
            <x:Double x:Key="NormalPaddingLeaf">1</x:Double>
            <x:Double x:Key="FocusPaddingLeaf">3</x:Double>

            <ControlTheme x:Key="ReproTheme" TargetType="Button">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border x:Name="PART_DynamicThickness"
                                Padding="{markup:DynamicThickness NormalPadding}" />
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:focus /template/ Border#PART_DynamicThickness">
                    <Setter Property="Padding" Value="{markup:DynamicThickness FocusPadding}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Button.Resources>
</Button>
