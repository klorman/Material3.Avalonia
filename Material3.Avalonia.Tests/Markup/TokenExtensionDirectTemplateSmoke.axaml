<Button xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:Material3.Avalonia.Markup"
        xmlns:tokens="using:Material3.Avalonia.Tokens"
        Theme="{StaticResource ReproTheme}">
    <Button.Resources>
        <ResourceDictionary>
            <tokens:TokenAlias x:Key="NormalToken" ResourceKey="NormalLeaf" />
            <tokens:TokenAlias x:Key="FocusToken" ResourceKey="FocusLeaf" />
            <x:Double x:Key="NormalLeaf">1</x:Double>
            <x:Double x:Key="FocusLeaf">3</x:Double>
            <x:Double x:Key="NativeFocusToken">4</x:Double>

            <ControlTheme x:Key="ReproTheme" TargetType="Button">
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel>
                            <Border x:Name="PART_Token"
                                    Height="{markup:Token NormalToken}" />

                            <Border x:Name="PART_Native"
                                    Height="{DynamicResource NormalLeaf}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:focus /template/ Border#PART_Token">
                    <Setter Property="Height" Value="{markup:Token FocusToken}" />
                </Style>

                <Style Selector="^:focus /template/ Border#PART_Native">
                    <Setter Property="Height" Value="{DynamicResource NativeFocusToken}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Button.Resources>
</Button>
