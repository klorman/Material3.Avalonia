<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Material3.Avalonia.Theme;assembly=Material3.Avalonia"
             xmlns:symbols="clr-namespace:Material3.Avalonia.Symbols;assembly=Material3.Avalonia"
             x:Class="Material3.Avalonia.Demo.App">
    <Application.Resources>
        <ResourceDictionary>
            <symbols:MaterialSymbolResource x:Key="MdIconMail" Symbol="Mail" />
            <symbols:MaterialSymbolsInclude
                x:Key="DynamicSymbols"
                Symbols="VisibilityOff" />
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <theme:MaterialTheme Mode="Light" Variant="TonalSpot" SourceColor="#6750A4" Contrast="Standard" MotionScheme="Expressive"
                            SymbolStyle="Rounded" />
    </Application.Styles>
</Application>
