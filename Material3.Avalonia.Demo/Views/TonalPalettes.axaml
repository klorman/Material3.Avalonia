<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Material3.Avalonia.Demo.Converters"
             xmlns:dynamicColor="clr-namespace:Bdziam.UI.Theming.MaterialColors.DynamicColor;assembly=Bdziam.DynamicColor"
             xmlns:markup="clr-namespace:Material3.Avalonia.Markup;assembly=Material3.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Material3.Avalonia.Demo.Views.TonalPalettes">
  <UserControl.Styles>
        <Style Selector="ContentControl.swatch">
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="{markup:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing0 MdSysSpacing100}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                  <Border Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Margin="{TemplateBinding Margin}"
                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                          Height="{TemplateBinding Height}">
                    <TextBlock Text="{TemplateBinding Content}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.9"/>
                  </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TextBlock.row-label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="{markup:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing200 MdSysSpacing100}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        </Style>
    </UserControl.Styles>
  
    <UserControl.Resources>
      <converters:TonalSwatchBrushConverter x:Key="SwatchBrushConverter" />
    </UserControl.Resources>
    
    <Grid RowDefinitions="Auto Auto Auto Auto Auto Auto"
          ColumnDefinitions="Auto *"
          Margin="{markup:DynamicThickness MdSysSpacing150}"
          x:DataType="dynamicColor:DynamicScheme"
          DataContext="{DynamicResource Material.DynamicScheme}">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="row-label" Text="Primary" />
        <UniformGrid Grid.Row="0" Grid.Column="1" Columns="14" Rows="1">
          <ContentControl Classes="swatch" Content="0"   Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary0}" Foreground="White" />
          <ContentControl Classes="swatch" Content="10"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary10}" Foreground="White" />
          <ContentControl Classes="swatch" Content="20"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary20}" Foreground="White" />
          <ContentControl Classes="swatch" Content="30"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary30}" Foreground="White" />
          <ContentControl Classes="swatch" Content="40"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary40}" Foreground="White" />
          <ContentControl Classes="swatch" Content="50"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary50}" Foreground="White" />
          <ContentControl Classes="swatch" Content="60"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary60}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="70"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary70}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="80"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary80}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="90"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary90}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="95"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary95}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="98"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary98}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="99"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary99}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="100" Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Primary100}" Foreground="Black" />
        </UniformGrid>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="row-label" Text="Secondary"/>
        <UniformGrid Grid.Row="1" Grid.Column="1" Columns="14" Rows="1">
          <ContentControl Classes="swatch" Content="0"   Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary0}" Foreground="White" />
          <ContentControl Classes="swatch" Content="10"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary10}" Foreground="White" />
          <ContentControl Classes="swatch" Content="20"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary20}" Foreground="White" />
          <ContentControl Classes="swatch" Content="30"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary30}" Foreground="White" />
          <ContentControl Classes="swatch" Content="40"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary40}" Foreground="White" />
          <ContentControl Classes="swatch" Content="50"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary50}" Foreground="White" />
          <ContentControl Classes="swatch" Content="60"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary60}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="70"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary70}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="80"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary80}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="90"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary90}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="95"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary95}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="98"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary98}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="99"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary99}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="100" Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Secondary100}" Foreground="Black" />
        </UniformGrid>

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="row-label" Text="Tertiary"/>
        <UniformGrid Grid.Row="2" Grid.Column="1" Columns="14" Rows="1">
          <ContentControl Classes="swatch" Content="0"   Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary0}" Foreground="White" />
          <ContentControl Classes="swatch" Content="10"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary10}" Foreground="White" />
          <ContentControl Classes="swatch" Content="20"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary20}" Foreground="White" />
          <ContentControl Classes="swatch" Content="30"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary30}" Foreground="White" />
          <ContentControl Classes="swatch" Content="40"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary40}" Foreground="White" />
          <ContentControl Classes="swatch" Content="50"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary50}" Foreground="White" />
          <ContentControl Classes="swatch" Content="60"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary60}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="70"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary70}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="80"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary80}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="90"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary90}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="95"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary95}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="98"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary98}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="99"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary99}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="100" Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Tertiary100}" Foreground="Black" />
        </UniformGrid>

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="row-label" Text="Neutral"/>
        <UniformGrid Grid.Row="3" Grid.Column="1" Columns="14" Rows="1">
          <ContentControl Classes="swatch" Content="0"   Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral0}" Foreground="White" />
          <ContentControl Classes="swatch" Content="10"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral10}" Foreground="White" />
          <ContentControl Classes="swatch" Content="20"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral20}" Foreground="White" />
          <ContentControl Classes="swatch" Content="30"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral30}" Foreground="White" />
          <ContentControl Classes="swatch" Content="40"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral40}" Foreground="White" />
          <ContentControl Classes="swatch" Content="50"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral50}" Foreground="White" />
          <ContentControl Classes="swatch" Content="60"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral60}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="70"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral70}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="80"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral80}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="90"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral90}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="95"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral95}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="98"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral98}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="99"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral99}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="100" Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Neutral100}" Foreground="Black" />
        </UniformGrid>

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="row-label" Text="Neutral variant"/>
        <UniformGrid Grid.Row="4" Grid.Column="1" Columns="14" Rows="1">
          <ContentControl Classes="swatch" Content="0"   Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant0}" Foreground="White" />
          <ContentControl Classes="swatch" Content="10"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant10}" Foreground="White" />
          <ContentControl Classes="swatch" Content="20"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant20}" Foreground="White" />
          <ContentControl Classes="swatch" Content="30"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant30}" Foreground="White" />
          <ContentControl Classes="swatch" Content="40"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant40}" Foreground="White" />
          <ContentControl Classes="swatch" Content="50"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant50}" Foreground="White" />
          <ContentControl Classes="swatch" Content="60"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant60}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="70"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant70}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="80"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant80}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="90"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant90}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="95"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant95}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="98"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant98}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="99"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant99}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="100" Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=NeutralVariant100}" Foreground="Black" />
        </UniformGrid>
        
        <TextBlock Grid.Row="5" Grid.Column="0" Classes="row-label" Text="Error"/>
        <UniformGrid Grid.Row="5" Grid.Column="1" Columns="14" Rows="1">
          <ContentControl Classes="swatch" Content="0"   Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error0}" Foreground="White" />
          <ContentControl Classes="swatch" Content="10"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error10}" Foreground="White" />
          <ContentControl Classes="swatch" Content="20"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error20}" Foreground="White" />
          <ContentControl Classes="swatch" Content="30"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error30}" Foreground="White" />
          <ContentControl Classes="swatch" Content="40"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error40}" Foreground="White" />
          <ContentControl Classes="swatch" Content="50"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error50}" Foreground="White" />
          <ContentControl Classes="swatch" Content="60"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error60}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="70"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error70}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="80"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error80}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="90"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error90}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="95"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error95}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="98"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error98}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="99"  Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error99}" Foreground="Black" />
          <ContentControl Classes="swatch" Content="100" Background="{Binding Converter={StaticResource SwatchBrushConverter}, ConverterParameter=Error100}" Foreground="Black" />
        </UniformGrid>
    </Grid>
</UserControl>
