<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Material3.Avalonia.Demo.Views"
        xmlns:m3="https://github.com/klorman/Material3.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Material3.Avalonia.Demo.Views.MainView"
        Background="{DynamicResource MdSysBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Visible"
                  m3:ScrollViewerAssist.ScrollBarInset="0 18">
        <StackPanel Orientation="Vertical"
                    Margin="{m3:DynamicThickness MdSysSpacing200}"
                    Spacing="{DynamicResource MdSysSpacing200}">
            <views:TonalPalettes IsVisible="False" />

            <views:SchemeColors HorizontalAlignment="Center" IsVisible="False" />

            <views:Buttons HorizontalAlignment="Center" IsVisible="True" />

            <views:ToggleButtons HorizontalAlignment="Center" />

            <views:IconButtons HorizontalAlignment="Center" />

            <views:FloatingActionButtons HorizontalAlignment="Stretch" />

            <views:CheckBoxes HorizontalAlignment="Stretch" />

            <views:RadioButtons HorizontalAlignment="Stretch" />

            <views:Switches HorizontalAlignment="Stretch" />

            <views:Badges HorizontalAlignment="Stretch" />

            <views:TextBoxes HorizontalAlignment="Center" IsVisible="True" />

            <views:Menus HorizontalAlignment="Stretch" />

            <views:ToolTips HorizontalAlignment="Center" />

            <views:ScrollViewers HorizontalAlignment="Center" IsVisible="True" />

            <Border IsVisible="False" BorderBrush="Black" BorderThickness="1" Padding="4" Margin="100" Width="{Binding $self.Bounds.Height}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <m3:MaterialShape Kind="Arch" Width="400" Height="400"
                                          Fill="{StaticResource MdSysOnSurfaceBrush}" />
            </Border>

            <views:Shapes HorizontalAlignment="Center" IsVisible="True" />

            <views:Cards HorizontalAlignment="Center" IsVisible="True" />

            <views:Dividers HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
