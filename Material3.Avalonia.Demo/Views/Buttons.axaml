<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:attached="clr-namespace:Material3.Avalonia.Attached;assembly=Material3.Avalonia"
             xmlns:controls="clr-namespace:Material3.Avalonia.Attached.Controls;assembly=Material3.Avalonia"
             xmlns:density="clr-namespace:Material3.Avalonia.Density;assembly=Material3.Avalonia"
             xmlns:helpers="clr-namespace:Material3.Avalonia.Controls.Helpers;assembly=Material3.Avalonia"
             xmlns:markup="clr-namespace:Material3.Avalonia.Markup;assembly=Material3.Avalonia"
             xmlns:symbols="clr-namespace:Material3.Avalonia.Symbols;assembly=Material3.Avalonia"
             xmlns:viewModels="clr-namespace:Material3.Avalonia.Demo.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="1200"
             x:Class="Material3.Avalonia.Demo.Views.Buttons"
             x:DataType="viewModels:ButtonsViewModel"
             ClipToBounds="False">

    <UserControl.Styles>
        <Style Selector="Border.demo-section">
            <Setter Property="Background" Value="{DynamicResource MdSysSurfaceContainerLowBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource MdSysShapeCornerLarge}" />
            <Setter Property="Padding" Value="{markup:DynamicThickness MdSysSpacing300}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="{markup:DynamicThickness MdSysSpacing300}"
                Spacing="{DynamicResource MdSysSpacing400}"
                attached:DensityAssist.Density="{Binding SelectedDensity}">
        <!-- Header -->
        <StackPanel Spacing="{DynamicResource MdSysSpacing100}">
            <TextBlock Text="Buttons"
                       Foreground="{DynamicResource MdSysOnBackgroundBrush}"
                       helpers:Typography.TextStyle="HeadlineMedium" />
            <TextBlock Text="Interactive Material 3 button gallery. Hover, focus, press and tab through each example to verify variants, sizes, icons and disabled behavior."
                       MaxWidth="696"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                       helpers:Typography.TextStyle="BodyMedium" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Spacing="{DynamicResource MdSysSpacing100}"
                    attached:DensityAssist.Density="{x:Static density:MaterialDensity.Default}">
            <TextBlock Text="Button density"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                       helpers:Typography.TextStyle="LabelLarge" />

            <Button Content="0"
                    Classes="outlined xs"
                    Command="{Binding SetDensityCommand}"
                    CommandParameter="{x:Static density:MaterialDensity.Default}" />
            <Button Content="-1"
                    Classes="outlined xs"
                    Command="{Binding SetDensityCommand}"
                    CommandParameter="{x:Static density:MaterialDensity.Dense1}" />
            <Button Content="-2"
                    Classes="outlined xs"
                    Command="{Binding SetDensityCommand}"
                    CommandParameter="{x:Static density:MaterialDensity.Dense2}" />
            <Button Content="-3"
                    Classes="outlined xs"
                    Command="{Binding SetDensityCommand}"
                    CommandParameter="{x:Static density:MaterialDensity.Dense3}" />
            <Button Content="-4"
                    Classes="outlined xs"
                    Command="{Binding SetDensityCommand}"
                    CommandParameter="{x:Static density:MaterialDensity.Dense4}" />
            <Button Content="-5"
                    Classes="outlined xs"
                    Command="{Binding SetDensityCommand}"
                    CommandParameter="{x:Static density:MaterialDensity.Dense5}" />
        </StackPanel>

        <!-- Sizes -->
        <Border Classes="demo-section">
            <StackPanel Spacing="{DynamicResource MdSysSpacing250}">
                <StackPanel Spacing="{DynamicResource MdSysSpacing50}">
                    <TextBlock Text="Sizes"
                               Foreground="{DynamicResource MdSysOnSurfaceBrush}"
                               helpers:Typography.TextStyle="TitleLarge" />
                    <TextBlock Text="Tonal buttons show the supported compact-to-prominent size scale."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                               helpers:Typography.TextStyle="BodySmall" />
                </StackPanel>

                <StackPanel Spacing="{DynamicResource MdSysSpacing200}"
                             Orientation="Horizontal">
                    <Button Content="Extra small"
                            Classes="tonal xs"
                            controls:ButtonAssist.Icon="{DynamicResource MdIconMail}" />
                    <Button Content="Small"
                            Classes="tonal sm"
                            controls:ButtonAssist.Icon="{DynamicResource MdIconMail}" />
                    <Button Content="Medium"
                            Classes="tonal md"
                            controls:ButtonAssist.Icon="{DynamicResource MdIconMail}" />
                    <Button Content="Large"
                            Classes="tonal lg"
                            controls:ButtonAssist.Icon="{DynamicResource MdIconMail}" />
                    <Button Content="Extra large"
                            Classes="tonal xl"
                            controls:ButtonAssist.Icon="{DynamicResource MdIconMail}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Variants -->
        <Border Classes="demo-section">
            <StackPanel Spacing="{DynamicResource MdSysSpacing250}">
                <StackPanel Spacing="{DynamicResource MdSysSpacing50}">
                    <TextBlock Text="Variants"
                               Foreground="{DynamicResource MdSysOnSurfaceBrush}"
                               helpers:Typography.TextStyle="TitleLarge" />
                    <TextBlock Text="The core Material 3 button variants share Avalonia's native pointer, keyboard, focus and command behavior."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                               helpers:Typography.TextStyle="BodySmall" />
                </StackPanel>

                <StackPanel Spacing="{DynamicResource MdSysSpacing200}"
                             Orientation="Horizontal">
                    <Button Content="Elevated"
                            Classes="elevated md" />
                    <Button Content="Filled"
                            Classes="filled md" />
                    <Button Content="Tonal"
                            Classes="tonal md" />
                    <Button Content="Outlined"
                            Classes="outlined md" />
                    <Button Content="Text"
                            Classes="text md" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- States -->
        <Border Classes="demo-section">
            <StackPanel Spacing="{DynamicResource MdSysSpacing250}">
                <StackPanel Spacing="{DynamicResource MdSysSpacing50}">
                    <TextBlock Text="Disabled states"
                               Foreground="{DynamicResource MdSysOnSurfaceBrush}"
                               helpers:Typography.TextStyle="TitleLarge" />
                    <TextBlock Text="Disabled buttons verify variant-specific content, container, outline and elevation treatment."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                               helpers:Typography.TextStyle="BodySmall" />
                </StackPanel>

                <StackPanel Spacing="{DynamicResource MdSysSpacing200}"
                             Orientation="Horizontal">
                    <Button Content="Elevated"
                            Classes="elevated md"
                            IsEnabled="False" />
                    <Button Content="Filled"
                            Classes="filled md"
                            IsEnabled="False" />
                    <Button Content="Tonal"
                            Classes="tonal md"
                            IsEnabled="False" />
                    <Button Content="Outlined"
                            Classes="outlined md"
                            IsEnabled="False" />
                    <Button Content="Text"
                            Classes="text md"
                            IsEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Icons -->
        <Border Classes="demo-section">
            <StackPanel Spacing="{DynamicResource MdSysSpacing250}">
                <StackPanel Spacing="{DynamicResource MdSysSpacing50}">
                    <TextBlock Text="Icon content"
                               Foreground="{DynamicResource MdSysOnSurfaceBrush}"
                               helpers:Typography.TextStyle="TitleLarge" />
                    <TextBlock Text="ButtonAssist.Icon accepts vector icon resources and bitmap asset URIs while preserving Material spacing and size tokens."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                               helpers:Typography.TextStyle="BodySmall" />
                </StackPanel>

                <StackPanel Spacing="{DynamicResource MdSysSpacing200}">
                    <StackPanel Spacing="{DynamicResource MdSysSpacing50}">
                        <TextBlock Text="Vector icon"
                                   Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                                   helpers:Typography.TextStyle="LabelLarge" />

                        <StackPanel Spacing="{DynamicResource MdSysSpacing200}"
                                    Orientation="Horizontal">
                            <Button Content="Elevated"
                                    Classes="elevated md"
                                    controls:ButtonAssist.Icon="{symbols:Symbol Edit}" />
                            <Button Content="Filled"
                                    Classes="filled md"
                                    controls:ButtonAssist.Icon="{symbols:Symbol Edit}" />
                            <Button Content="Tonal"
                                    Classes="tonal md"
                                    controls:ButtonAssist.Icon="{symbols:Symbol Edit}" />
                            <Button Content="Outlined"
                                    Classes="outlined md"
                                    controls:ButtonAssist.Icon="{symbols:Symbol Edit}" />
                            <Button Content="Text"
                                    Classes="text md"
                                    controls:ButtonAssist.Icon="{symbols:Symbol Edit}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="{DynamicResource MdSysSpacing50}">
                        <TextBlock Text="Bitmap icon"
                                   Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                                   helpers:Typography.TextStyle="LabelLarge" />

                        <StackPanel Spacing="{DynamicResource MdSysSpacing200}"
                                    Orientation="Horizontal">
                            <Button Content="Elevated"
                                    Classes="elevated md"
                                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
                            <Button Content="Filled"
                                    Classes="filled md"
                                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
                            <Button Content="Tonal"
                                    Classes="tonal md"
                                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
                            <Button Content="Outlined"
                                    Classes="outlined md"
                                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
                            <Button Content="Text"
                                    Classes="text md"
                                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Shape -->
        <Border Classes="demo-section">
            <StackPanel Spacing="{DynamicResource MdSysSpacing250}">
                <StackPanel Spacing="{DynamicResource MdSysSpacing50}">
                    <TextBlock Text="Square shape"
                               Foreground="{DynamicResource MdSysOnSurfaceBrush}"
                               helpers:Typography.TextStyle="TitleLarge" />
                    <TextBlock Text="The square class verifies the alternate shape path across every button variant."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MdSysOnSurfaceVariantBrush}"
                               helpers:Typography.TextStyle="BodySmall" />
                </StackPanel>

                <StackPanel Spacing="{DynamicResource MdSysSpacing200}"
                             Orientation="Horizontal">
                    <Button Content="Elevated"
                            Classes="elevated md square" />
                    <Button Content="Filled"
                            Classes="filled md square" />
                    <Button Content="Tonal"
                            Classes="tonal md square" />
                    <Button Content="Outlined"
                            Classes="outlined md square" />
                    <Button Content="Text"
                            Classes="text md square" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="demo-section">
            <StackPanel Spacing="{DynamicResource MdSysSpacing200}">
                <TextBlock Text="Resize motion" helpers:Typography.TextStyle="TitleLarge" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource MdSysSpacing200}">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource MdSysSpacing100}">
                        <TextBlock Text="Leading edge" helpers:Typography.TextStyle="LabelMedium" />
                        <Button x:Name="ResizeSample"
                                MinWidth="160"
                                Content="Save"
                                Classes="filled sm" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource MdSysSpacing100}">
                        <TextBlock Text="Centered" TextAlignment="Center" helpers:Typography.TextStyle="LabelMedium" />
                        <Button x:Name="ResizeSampleCentered"
                                Content="Save"
                                Classes="filled sm"
                                MinWidth="160"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{DynamicResource MdSysSpacing100}">
                        <TextBlock Text="RTL" TextAlignment="Right" helpers:Typography.TextStyle="LabelMedium" />
                        <Button x:Name="ResizeSampleRtl"
                                Content="Save"
                                Classes="filled sm"
                                MinWidth="160"
                                FlowDirection="RightToLeft"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MdSysSpacing100}">
                    <Button Content="Change label" Classes="outlined xs" Click="OnResizeLabelClick" />
                    <Button Content="Toggle icon" Classes="outlined xs" Click="OnResizeIconClick" />
                    <Button Content="Change size" Classes="outlined xs" Click="OnResizeSizeClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
